// =============================================================================
// PARTIDA E SIMULAÇÃO — §3.8 / §6.3.7
// =============================================================================

model Match {
  id                  String             @id @default(uuid(7)) @db.Uuid
  gameWorldId         String             @db.Uuid
  competitionSeasonId String?            @db.Uuid
  stageId             String?            @db.Uuid
  homeClubId          String             @db.Uuid
  awayClubId          String             @db.Uuid
  seasonNumber        Int
  roundNumber         Int?
  scheduledAt         DateTime
  startedAt           DateTime?
  finishedAt          DateTime?
  runtimeStatus       MatchRuntimeStatus @default(SCHEDULED) // ciclo de vida
  resultStatus        MatchResultStatus  @default(PENDING) // desfecho
  homologationStatus  HomologationStatus @default(PENDING) // confirmação oficial
  homeGoals           Int                @default(0)
  awayGoals           Int                @default(0)
  homeExpectedGoals   Decimal?           @db.Decimal(8, 4) // xG: não-monetário
  awayExpectedGoals   Decimal?           @db.Decimal(8, 4)
  simulationSeed      String? // replay determinístico
  simulatedOffline    Boolean            @default(false) // + MatchControlSource
  version             Int                @default(1)

  competitionSeason CompetitionSeason?   @relation(fields: [competitionSeasonId], references: [id], onDelete: SetNull)
  stage             CompetitionStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  homeClub          Club                 @relation("HomeClubMatches", fields: [homeClubId], references: [id], onDelete: Cascade)
  awayClub          Club                 @relation("AwayClubMatches", fields: [awayClubId], references: [id], onDelete: Cascade)
  teamStates        MatchTeamState[]
  lineups           MatchLineup[]
  events            MatchEvent[]
  playerStats       PlayerMatchStats[]
  simulation        MatchSimulation?
  decisionPoints    MatchDecisionPoint[]

  @@index([gameWorldId])
  @@index([competitionSeasonId])
  @@index([homeClubId])
  @@index([awayClubId])
}

/// Cabeçalho do `SimulationManifest` imutável (I + R + A + s + C + hashes) — o
/// registro que permite replay bit-a-bit e auditoria (doc 15 §3). Uma vez que a
/// partida sai de PRE_MATCH (entradas congeladas) e FINISHED (commands fechados),
/// o manifesto NÃO muda; correção gera nova versão.
model MatchSimulation {
  id                    String  @id @default(uuid(7)) @db.Uuid
  gameWorldId           String  @db.Uuid
  matchId               String  @unique @db.Uuid
  engineVersion         String // identifica o kernel K (compatibilidade de replay)
  tickIntervalSeconds   Int // timestep canônico (PROPOSTO R-143: 60 s virtuais)
  totalTicks            Int
  homeStrengthSnapshot  Json // fotografia da força ofensiva/defensiva (parte de I)
  awayStrengthSnapshot  Json
  randomSeed            String // seed mestra s (determinismo)
  balanceJson           Json?
  finalMomentumJson     Json?
  // --- SimulationManifest: campos a adicionar (doc 15 §3.1) — PROPOSTO (R-145/R-146) ---
  rulesetVersionId      String? @db.Uuid // carimba R (ruleset da época) no kickoff (R-145)
  rngAlgorithm          String? // nomeia A (ex.: pcg32-xsh-rr) — R-146
  rngStreamsJson        Json? // seletores das streams por finalidade (R-146)
  contextSnapshot       Json? // clima/gramado/árbitro/torcida/importância/mando (I) — R-145
  lineupSnapshot        Json? // escalações congeladas e imutáveis no kickoff (I) — R-145
  inputHash             String? // hash de todo I (força+contexto+escalação+ruleset+rng+seed)
  homeStrengthHash      String? // hash por snapshot (isola qual entrada divergiu)
  awayStrengthHash      String?
  contextHash           String?
  lineupHash            String?
  resultHash            String? // hash do O (placar+eventos+série de ticks)
  hashAlgorithm         String? // nomeia a função de hash (ex.: sha256) — R-145
  manifestSchemaVersion Int? // versiona o formato do próprio manifesto — R-145
  version               Int     @default(1) // concorrência otimista durante a construção

  match      Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  ticks      MatchSimulationTick[]
  commandLog MatchCommandLog[] // C ordenado (doc 15 §3.2) — R-145
}

model MatchSimulationTick {
  id             String  @id @default(uuid(7)) @db.Uuid
  simulationId   String  @db.Uuid
  minute         Int
  second         Int?
  homeMomentum   Decimal @db.Decimal(8, 4)
  awayMomentum   Decimal @db.Decimal(8, 4)
  homeThreat     Decimal @db.Decimal(8, 4)
  awayThreat     Decimal @db.Decimal(8, 4)
  homeFatigueAvg Decimal @db.Decimal(8, 4)
  awayFatigueAvg Decimal @db.Decimal(8, 4)
  data           Json?

  simulation MatchSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId])
}

model MatchTeamState {
  id                  String             @id @default(uuid(7)) @db.Uuid
  matchId             String             @db.Uuid
  clubId              String             @db.Uuid
  controlSource       MatchControlSource
  mentality           TacticalMentality  @default(BALANCED)
  pressing            PressingIntensity  @default(MEDIUM)
  marking             MarkingStyle       @default(ZONAL)
  tempo               TempoStyle         @default(NORMAL)
  formation           String
  lineHeight          Int                @default(50)
  defensiveWidth      Int                @default(50)
  attackingWidth      Int                @default(50)
  riskLevel           Int                @default(50)
  morale              Int                @default(50)
  fatigueAvg          Int                @default(0)
  tacticalCohesion    Int                @default(50)
  currentInstructions Json?
  version             Int                @default(1) // concorrência otimista (agregado C8 · runtime)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, clubId])
}

/// Escalação da partida. Canônico (doc 15 §3.1, campo 8, PROPOSTO R-145):
/// a escalação usada pelo kernel é um SNAPSHOT CONGELADO E IMUTÁVEL no kickoff
/// (parte de `I`). Após `frozenAtTick`/PRE_MATCH ela NÃO pode mutar — corresponde
/// ao `lineupSnapshot` do manifesto; `lineupHash` prova a não-adulteração.
model MatchLineup {
  id                  String  @id @default(uuid(7)) @db.Uuid
  matchId             String  @db.Uuid
  clubId              String  @db.Uuid
  formation           String
  isInitial           Boolean @default(true)
  isImmutableSnapshot Boolean @default(true) // congelada no kickoff (não mutável)
  frozenAtTick        Int? // tick em que a escalação foi congelada (kickoff)
  snapshotJson        Json? // estado congelado (titulares/banco/funções) para o manifesto
  lineupHash          String? // hash do snapshot (integridade — doc 15 §3.3)

  match   Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  players MatchLineupPlayer[]

  @@index([matchId])
}

model MatchLineupPlayer {
  id                        String         @id @default(uuid(7)) @db.Uuid
  lineupId                  String         @db.Uuid
  playerId                  String         @db.Uuid
  position                  PlayerPosition
  shirtNumber               Int?
  isStarter                 Boolean        @default(true)
  enteredMinute             Int?
  leftMinute                Int?
  tacticalRole              String?
  individualInstructionJson Json?

  lineup MatchLineup @relation(fields: [lineupId], references: [id])
  player Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([lineupId])
  @@index([playerId])
}

model MatchEvent {
  id              String         @id @default(uuid(7)) @db.Uuid
  matchId         String         @db.Uuid
  clubId          String?        @db.Uuid
  playerId        String?        @db.Uuid
  relatedPlayerId String?        @db.Uuid
  type            MatchEventType
  minute          Int
  second          Int?
  eventSequence   Int // C-11: ordem TOTAL do feed por partida (desempata minute/second); a partida (matchId) é o escopo — MatchEvent não tem simulationId
  description     String
  importance      Int            @default(1)
  x               Decimal?       @db.Decimal(8, 4) // coordenada no campo
  y               Decimal?       @db.Decimal(8, 4)
  data            Json?

  match         Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player        Player? @relation("EventPlayer", fields: [playerId], references: [id])
  relatedPlayer Player? @relation("EventRelatedPlayer", fields: [relatedPlayerId], references: [id])

  @@unique([matchId, eventSequence]) // C-11: ordem total estável do feed
  @@index([matchId])
  @@index([playerId])
}

model PlayerMatchStats {
  id              String  @id @default(uuid(7)) @db.Uuid
  matchId         String  @db.Uuid
  playerId        String  @db.Uuid
  minutesPlayed   Int     @default(0)
  goals           Int
  assists         Int
  shots           Int
  shotsOnTarget   Int
  passesAttempted Int
  passesCompleted Int
  tackles         Int
  interceptions   Int
  foulsCommitted  Int
  yellowCards     Int
  redCards        Int
  saves           Int
  goalsConceded   Int
  rating          Decimal @default(6.00) @db.Decimal(4, 2)
  fatigueStart    Int
  fatigueEnd      Int
  moraleImpact    Int     @default(0)

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

model MatchDecisionPoint {
  id                    String               @id @default(uuid(7)) @db.Uuid
  matchId               String               @db.Uuid
  clubId                String               @db.Uuid
  type                  DecisionPointType
  minute                Int
  title                 String
  description           String
  urgency               RecommendationImpact
  createdByStaffQuality Int?
  resolved              Boolean              @default(false)
  resolvedAt            DateTime?
  chosenActionId        String?              @db.Uuid
  data                  Json?
  version               Int                  @default(1) // concorrência otimista (agregado C8 · runtime)

  match           Match                       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  recommendations MatchActionRecommendation[]

  @@index([matchId])
}

model MatchActionRecommendation {
  id                      String               @id @default(uuid(7)) @db.Uuid
  decisionPointId         String               @db.Uuid
  title                   String
  description             String
  impact                  RecommendationImpact
  confidence              Int
  tacticalChangeJson      Json?
  substitutionJson        Json?
  riskJson                Json?
  generatedByStaffRole    StaffRole?
  generatedByStaffQuality Int?

  decisionPoint MatchDecisionPoint @relation(fields: [decisionPointId], references: [id])

  @@index([decisionPointId])
}

// =============================================================================
// ESTATÍSTICAS, NARRATIVA, NOTIFICAÇÃO, AUTOMAÇÃO E AUDITORIA — §3.9–3.11
// =============================================================================

model ClubSeasonStats {
  id                  String    @id @default(uuid(7)) @db.Uuid
  clubId              String    @db.Uuid
  seasonId            String    @db.Uuid
  competitionSeasonId String?   @db.Uuid // M-04: dimensão por competição; NULL = agregado geral da temporada
  matchesPlayed       Int
  wins                Int
  draws               Int
  losses              Int
  goalsFor            Int
  goalsAgainst        Int
  points              Int
  finalPosition       Int?
  titlesWon           Int       @default(0)
  averageAttendance   Int       @default(0)
  fanMood             MoodLevel @default(NEUTRAL)

  club              Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  competitionSeason CompetitionSeason? @relation(fields: [competitionSeasonId], references: [id], onDelete: SetNull)

  @@unique([clubId, seasonId, competitionSeasonId]) // M-04: agregado geral (NULL) coexiste com linhas por competição
}

model PlayerSeasonStats {
  id                  String  @id @default(uuid(7)) @db.Uuid
  playerId            String  @db.Uuid
  seasonId            String  @db.Uuid
  clubId              String? @db.Uuid
  competitionSeasonId String? @db.Uuid // M-04: dimensão por competição; NULL = agregado geral da temporada
  appearances         Int
  starts              Int
  minutesPlayed       Int
  goals               Int
  assists             Int
  yellowCards         Int
  redCards            Int
  averageRating       Decimal @default(0) @db.Decimal(4, 2)
  injuriesCount       Int     @default(0)

  player            Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  competitionSeason CompetitionSeason? @relation(fields: [competitionSeasonId], references: [id], onDelete: SetNull)

  @@unique([playerId, seasonId, competitionSeasonId]) // M-04: agregado geral (NULL) coexiste com linhas por competição
}

model Narrative {
  id          String        @id @default(uuid(7)) @db.Uuid
  gameWorldId String        @db.Uuid
  clubId      String?       @db.Uuid
  playerId    String?       @db.Uuid
  type        NarrativeType
  title       String
  description String
  intensity   Int           @default(1)
  isActive    Boolean       @default(true)
  startsAt    DateTime      @default(now())
  endsAt      DateTime?
  effectsJson Json? // efeitos aplicados (moral, pressão, valor etc.)

  gameWorld GameWorld @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)

  @@index([gameWorldId])
}

model Notification {
  id          String           @id @default(uuid(7)) @db.Uuid
  gameWorldId String?          @db.Uuid
  userId      String?          @db.Uuid
  clubId      String?          @db.Uuid
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  priority    Int              @default(1)
  payload     Json?
  createdAt   DateTime         @default(now())
  readAt      DateTime?

  gameWorld GameWorld?   @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)
  user      UserAccount? @relation(fields: [userId], references: [id])

  @@index([gameWorldId])
  @@index([userId])
}

/// Projeção transversal de auditoria — referência genérica (entity/entityId)
/// permitida. Forma canônica com cadeia de hash de integridade: AuditEvent (§6.3.11).
model GameAuditLog {
  id                    String   @id @default(uuid(7)) @db.Uuid
  gameWorldId           String?  @db.Uuid
  userId                String?  @db.Uuid
  clubId                String?  @db.Uuid
  action                String
  entity                String
  entityId              String?  @db.Uuid
  beforeJson            Json?
  afterJson             Json?
  metadata              Json?
  integrityHash         String? // C-12: hash deste registro (append-only, à prova de adulteração)
  previousIntegrityHash String? // C-12: encadeia ao registro anterior (hash-chain)
  createdAt             DateTime @default(now())

  gameWorld GameWorld? @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)

  @@index([gameWorldId])
}

/// Atalho chave-valor para parâmetros simples de balanceamento por mundo.
/// Forma canônica de regras versionadas: RuleSet/RuleDefinition/RuleValue (§6.1).
model GameRuleConfig {
  id          String @id @default(uuid(7)) @db.Uuid
  gameWorldId String @db.Uuid
  key         String
  value       Json

  gameWorld GameWorld @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)

  @@unique([gameWorldId, key])
}

/// Regra de automação por clube (§6.3.11). Execução referencia sempre a versão.
model AutomationRule {
  id            String               @id @default(uuid(7)) @db.Uuid
  gameWorldId   String               @db.Uuid
  clubId        String               @db.Uuid
  name          String
  level         AutomationLevel      @default(ASSISTED)
  status        AutomationRuleStatus @default(DRAFT)
  triggerJson   Json?
  conditionJson Json?
  actionJson    Json?
  risk          Int                  @default(1) // 1..5; alto risco (≥4) não é delegável (X-001)
  priority      Int                  @default(0) // desempata precedência entre regras do mesmo gatilho
  version       Int                  @default(1)

  club     Club                    @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id], onDelete: Cascade)
  versions AutomationRuleVersion[]

  @@index([gameWorldId, clubId])
}

// O histórico IMUTÁVEL de uma regra (X-001, canon: AutomationRuleVersion). Cada
// SaveAutomation congela uma versão; a regra aponta para a mais nova (`version`).
model AutomationRuleVersion {
  id            String               @id @default(uuid(7)) @db.Uuid
  ruleId        String               @db.Uuid
  version       Int
  name          String
  level         AutomationLevel
  status        AutomationRuleStatus
  triggerJson   Json?
  conditionJson Json?
  actionJson    Json?
  risk          Int
  priority      Int

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@index([ruleId])
}

// =============================================================================
// EVENTING / OUTBOX / EVENT SOURCING HÍBRIDO — §6.3.11 (concern Eventing/Projeção;
// context-map §5/§6). Publicação pós-commit AT_LEAST_ONCE + idempotência de consumo.
// Referência genérica (aggregateType/aggregateId) permitida por ser event log (§6.4).
// =============================================================================

/// Outbox transacional: evento gravado na MESMA tx do agregado e publicado
/// pós-commit. Ordenado por `sequence` (worldSequence). Forma granular §6.3.11: OutboxEvent.
model OutboxEvent {
  id               String       @id @default(uuid(7)) @db.Uuid // = eventId
  gameWorldId      String       @db.Uuid
  aggregateType    String
  aggregateId      String       @db.Uuid
  aggregateVersion BigInt?
  eventType        String
  eventVersion     Int          @default(1)
  payloadJson      Json
  status           OutboxStatus @default(PENDING)
  sequence         BigInt // worldSequence monotônico por mundo
  correlationId    String?      @db.Uuid
  causationId      String?      @db.Uuid
  contentHash      String? // integridade do payload
  attemptCount     Int          @default(0)
  occurredAt       DateTime     @default(now())
  publishedAt      DateTime?

  @@unique([gameWorldId, sequence])
  @@index([gameWorldId, status])
  @@index([aggregateType, aggregateId])
}

/// Idempotência de consumo (Inbox): 1 processamento por consumidor/evento.
/// Forma granular §6.3.11: InboxEvent. Constraint: unique(consumerName, eventId).
model InboxDedup {
  id           String   @id @default(uuid(7)) @db.Uuid
  consumerName String
  eventId      String   @db.Uuid
  gameWorldId  String?  @db.Uuid
  resultHash   String?
  processedAt  DateTime @default(now())

  @@unique([consumerName, eventId])
  @@index([gameWorldId])
}

/// Event sourcing híbrido: log append-only de eventos de domínio com cadeia de
/// hash de integridade (`prevEventHash`→`eventHash`). Forma granular §6.3.11:
/// DomainEvent. Ordem por agregado (aggregateVersion) e por mundo (sequence).
model DomainEventLog {
  id                  String   @id @default(uuid(7)) @db.Uuid // = eventId
  gameWorldId         String   @db.Uuid
  aggregateType       String
  aggregateId         String   @db.Uuid
  aggregateVersion    BigInt
  sequence            BigInt // worldSequence
  eventType           String
  eventVersion        Int      @default(1)
  payloadJson         Json
  actorType           String?
  actorId             String?  @db.Uuid
  // Texto, não Uuid: `correlationId` e `causationId` vêm do CLIENTE (doc 08:
  // "identificador de correlação para rastreio", sem tipo). Constranger a Uuid
  // um valor que não controlamos não compra nada — só troca um rastreio por um
  // erro de banco no primeiro cliente que mandar "c1". O contrato do envelope
  // sempre disse `z.string().min(1)`; era o schema que divergia.
  correlationId       String?
  causationId         String?
  prevEventHash       String? // encadeamento de integridade
  eventHash           String?
  occurredAt          DateTime @default(now())
  occurredAtWorldTick BigInt?

  @@unique([gameWorldId, aggregateType, aggregateId, aggregateVersion])
  @@unique([gameWorldId, sequence])
  @@index([gameWorldId, eventType])
}

// =============================================================================
// CONCORRÊNCIA / RECUPERAÇÃO — idempotência de command e sagas (§6.3.11,
// context-map §6.3). Sem 2PC (Decisão 19.10); fencing por token monotônico.
// =============================================================================

/// Idempotência de command: 1 execução lógica por (actor, idempotencyKey) e 1 por
/// commandId. Forma granular §6.3.11: IdempotencyRecord/CommandExecution.
model IdempotencyKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  gameWorldId    String?   @db.Uuid
  actorId        String?   @db.Uuid
  idempotencyKey String
  // Identifica o PEDIDO — distingue reenvio de reúso. Sem ele a chave só sabia
  // que já fora usada, não com o quê, e `IDEMPOTENCY_KEY_REUSED`
  // (`10-catalogo-de-commands.md:61`, errorCode comum de TODA mutação) era
  // indetectável. É a serialização canônica do payload, não hash: comparação
  // exata, e o core roda no React Native, sem `node:crypto`.
  //
  // Sem `@default`: um insert que esquecesse o campo pegaria o default calado e
  // toda chave com fingerprint vazio casaria com toda outra — reúso viraria
  // replay. A migration usa um default temporário só para preencher as linhas
  // que já existem, e o derruba em seguida.
  requestFingerprint String
  commandId      String?   @db.Uuid
  commandType    String?
  status         String    @default("PENDING")
  resultHash     String?
  resultPayload  Json?
  errorCode      String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  expiresAt      DateTime?

  @@unique([actorId, idempotencyKey])
  @@unique([commandId])
  @@index([gameWorldId])
}

/// Saga / process manager (multiagregado, multicontexto). Cada passo é uma tx
/// local do contexto dono; falha posterior dispara compensação. Forma granular
/// §6.3.11: ProcessManager. Estados/timeouts finos: passo 10 da ordem de correção.
model SagaInstance {
  id            String     @id @default(uuid(7)) @db.Uuid
  gameWorldId   String     @db.Uuid
  sagaType      SagaType
  status        SagaStatus @default(CREATED)
  currentStep   Int        @default(0)
  correlationId String?    @db.Uuid
  contextJson   Json?
  fencingToken  BigInt     @default(0) // token monotônico (impede dois executores)
  lastError     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?
  version       Int        @default(1)

  steps SagaStep[]

  @@index([gameWorldId, status])
  @@index([sagaType, status])
}

/// Passo de uma saga (com estado de compensação). Forma granular §6.3.11: ProcessManagerStep.
model SagaStep {
  id                 String          @id @default(uuid(7)) @db.Uuid
  sagaInstanceId     String          @db.Uuid
  stepIndex          Int
  name               String
  status             SagaStepStatus  @default(PENDING)
  compensationStatus SagaStepStatus?
  attemptCount       Int             @default(0)
  payloadJson        Json?
  error              String?
  startedAt          DateTime?
  completedAt        DateTime?

  saga SagaInstance @relation(fields: [sagaInstanceId], references: [id], onDelete: Cascade)

  @@unique([sagaInstanceId, stepIndex])
  @@index([sagaInstanceId])
}

// =============================================================================
// LEDGER FINANCEIRO (partidas dobradas) — §6.3.9 + doc 13 (ledger e conservação).
// Saldo DERIVADO do razão (sem caixa editável isolado — fecha C-06). Conta pode
// ser de escopo CLUBE ou MUNDO (SYS_* de contraparte a faucet/sink — INV-3b).
// Forma granular §6.3.9: FinancialJournalEntry/FinancialJournalLine.
// =============================================================================

/// Conta do razão. `ownerScope=WORLD` + `systemAccount` para as SYS_* sistêmicas
/// (contraparte de faucet/sink; NÃO entram em `totalMoney`); `ownerScope=CLUB`
/// referencia um clube. Saldo deriva das linhas POSTED — não há coluna de saldo.
/// PROPOSTO (R-110) quanto ao `ownerScope=WORLD` das contas sistêmicas.
model FinancialAccount {
  id              String               @id @default(uuid(7)) @db.Uuid
  gameWorldId     String               @db.Uuid
  ownerScope      AccountOwnerScope    @default(CLUB)
  clubId          String?              @db.Uuid // nulo quando ownerScope=WORLD
  systemAccount   SystemAccount? // preenchido só para contas SYS_* (WORLD)
  accountCode     String
  accountType     FinancialAccountType
  normalSide      AccountNormalSide
  currencyId      String               @db.Uuid
  parentAccountId String?              @db.Uuid
  status          String               @default("ACTIVE")
  version         Int                  @default(1)

  currency Currency           @relation(fields: [currencyId], references: [id])
  club     Club?              @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id]) // C-05: FK composta world-scoped
  parent   FinancialAccount?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children FinancialAccount[] @relation("AccountHierarchy")
  lines    JournalLine[]

  @@unique([gameWorldId, ownerScope, accountCode])
  @@unique([gameWorldId, systemAccount]) // 1 conta por SYS_* por mundo (nulos distintos)
  @@index([gameWorldId, clubId])
}

/// Lançamento (transação lógica) balanceado: Σ débitos = Σ créditos por moeda
/// (INV-3a). Ciclo DRAFT→POSTING→POSTED→REVERSED; só POSTED afeta saldo. Reversão
/// cria NOVO lançamento com `reversalOfJournalEntryId` (publicado nunca é editado).
/// `flowClass` (doc 13 §2.1): TRANSFER conserva; FAUCET cria; SINK destrói a oferta.
/// Forma granular §6.3.9: FinancialJournalEntry.
model JournalEntry {
  id                       String                  @id @default(uuid(7)) @db.Uuid
  gameWorldId              String                  @db.Uuid
  clubId                   String?                 @db.Uuid // clube "dono" (nulo p/ lançamento sistêmico puro)
  currencyId               String                  @db.Uuid
  flowClass                MoneyFlowClass
  financeType              FinanceTransactionType?
  status                   JournalEntryStatus      @default(DRAFT)
  description              String?
  reversalOfJournalEntryId String?                 @db.Uuid
  sourceEventId            String?                 @db.Uuid // idempotência da projeção (1 lançamento por evento)
  seasonNumber             Int?
  occurredAt               DateTime                @default(now())
  postedAt                 DateTime?
  version                  Int                     @default(1)

  currency Currency     @relation(fields: [currencyId], references: [id])
  lines    JournalLine[]

  @@index([gameWorldId, clubId])
  @@index([gameWorldId, status])
}

/// Linha de débito/crédito. `amountMinor > 0` (CHECK em migration); o sinal vem
/// de `direction`. Constraint: soma dos débitos = soma dos créditos por lançamento
/// e moeda. Forma granular §6.3.9: FinancialJournalLine.
model JournalLine {
  id                 String               @id @default(uuid(7)) @db.Uuid
  gameWorldId        String               @db.Uuid
  journalEntryId     String               @db.Uuid
  lineNumber         Int
  financialAccountId String               @db.Uuid
  direction          JournalLineDirection
  amountMinor        BigInt // dinheiro em unidade mínima (> 0; sinal vem de `direction`)
  currencyId         String               @db.Uuid
  costCenterCode     String?
  referenceType      String?
  referenceId        String?              @db.Uuid

  entry    JournalEntry     @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account  FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  currency Currency         @relation(fields: [currencyId], references: [id])

  @@unique([journalEntryId, lineNumber])
  @@index([financialAccountId])
  @@index([gameWorldId])
}

/// Buffer de accrual de desenvolvimento (doc 13 §5.2 — PROPOSTO R-113). Pós-partida
/// ACUMULA evidência por jogador/atributo/temporada; a mutação estrutural do
/// atributo ocorre 1× na virada (CMP-005). `pendingDeltaMinor` é delta ESCALADO
/// (base interna E8), NÃO dinheiro (o sufixo segue o nome do doc 13). Idempotência:
/// buffer consumido (zerado) na aplicação — reprocessar a virada não reaplica ganho.
model PlayerDevelopmentAccrual {
  id                String  @id @default(uuid(7)) @db.Uuid
  gameWorldId       String  @db.Uuid
  playerId          String  @db.Uuid
  seasonId          String  @db.Uuid
  attributeCode     String
  pendingDeltaMinor BigInt  @default(0) // delta escalado acumulado (±), NÃO-monetário
  evidenceCount     Int     @default(0)
  lastUpdatedTick   BigInt?
  version           Int     @default(1)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, seasonId, attributeCode])
  @@index([gameWorldId, playerId])
}

// =============================================================================
// INSCRIÇÕES COMPETITIVAS (independentes do contrato) — §6.3.7 / context-map C7.
// Registro competitivo ≠ contrato (C6) ≠ elenco (C3). Cotas: estrangeiros,
// formados, limite de elenco. Relação inscrição↔competição é EXPLÍCITA (§6.4).
// =============================================================================

/// Inscrição de um clube numa edição (a "lista"/roster — SquadRegistration).
/// Guarda cotas e contadores. Invariante: 1 inscrição por clube/edição.
model CompetitionRegistration {
  id                  String             @id @default(uuid(7)) @db.Uuid
  gameWorldId         String             @db.Uuid
  competitionSeasonId String             @db.Uuid
  clubId              String             @db.Uuid
  status              RegistrationStatus @default(DRAFT)
  squadSizeLimit      Int? // limite de elenco inscrito
  foreignPlayerLimit  Int? // cota de estrangeiros
  homegrownMinimum    Int? // mínimo de formados (cota de formação)
  registeredCount     Int                @default(0)
  foreignCount        Int                @default(0)
  homegrownCount      Int                @default(0)
  submittedAt         DateTime?
  approvedAt          DateTime?
  version             Int                @default(1)

  competitionSeason CompetitionSeason    @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  players           PlayerRegistration[]

  @@unique([competitionSeasonId, clubId]) // 1 inscrição por clube/edição
  @@index([gameWorldId, clubId])
}

/// Inscrição individual de jogador sob a lista do clube. `slotType` classifica o
/// jogador para as cotas. Invariantes: 1 inscrição por jogador/edição; nº de
/// camisa único por lista. Forma granular §6.3.5/§6.3.7: PlayerRegistration.
model PlayerRegistration {
  id             String               @id @default(uuid(7)) @db.Uuid
  gameWorldId    String               @db.Uuid
  registrationId String               @db.Uuid
  playerId       String               @db.Uuid
  clubId         String               @db.Uuid
  status         RegistrationStatus   @default(SUBMITTED)
  slotType       RegistrationSlotType @default(GENERAL)
  shirtNumber    Int?
  registeredAt   DateTime             @default(now())
  deregisteredAt DateTime?
  version        Int                  @default(1)

  registration CompetitionRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, playerId]) // 1 inscrição por jogador/edição
  @@unique([registrationId, shirtNumber]) // nº de camisa único por lista (nulos distintos)
  @@index([gameWorldId, playerId])
}

// =============================================================================
// REPLAY — log imutável de commands da partida (`C` do kernel) — doc 15 §3.2.
// =============================================================================

/// Log imutável de commands da partida (`C`) para replay bit-a-bit (doc 15 §3.2 —
/// PROPOSTO R-145). Ordem-verdade por `matchSequence` (server-assigned);
/// `appliedAtTick` = tick determinístico de aplicação (§2.3). `payloadSnapshot` é
/// estado CONGELADO (não referência mutável). Reaplicar em ordem sobre (I,R,A,s) = replay.
model MatchCommandLog {
  id              String             @id @default(uuid(7)) @db.Uuid
  gameWorldId     String             @db.Uuid
  simulationId    String             @db.Uuid
  matchSequence   BigInt // ordem-verdade (server-assigned)
  appliedAtTick   Int // tick determinístico de aplicação
  commandType     String
  controlSource   MatchControlSource
  payloadSnapshot Json // estado congelado do command
  commandId       String             @db.Uuid // idempotência / desempate estável
  idempotencyKey  String?
  acceptedAt      DateTime           @default(now()) // auditoria (não entra no cálculo)

  simulation MatchSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, matchSequence])
  @@index([gameWorldId])
}

// =============================================================================
// HISTÓRICO (append-only) — "a história nunca é apagada" (CMP-019, INV-6). §6.3.11.
// Projeções transversais: referência escalar/genérica controlada permitida (§6.4).
// =============================================================================

/// Livro da temporada (append-only): campeões, rebaixados, prêmios e recordes do
/// ano consolidados. Forma granular §6.3.11: SeasonHistoryBook.
model SeasonHistory {
  id           String   @id @default(uuid(7)) @db.Uuid
  gameWorldId  String   @db.Uuid
  seasonId     String   @db.Uuid
  seasonNumber Int
  summaryJson  Json? // campeões/rebaixados/prêmios/artilharia consolidados
  recordedAt   DateTime @default(now())

  @@unique([gameWorldId, seasonNumber])
  @@index([gameWorldId])
}

/// Livro de recordes (append-only): ocorrência + detentor de um recorde. Forma
/// granular §6.3.11: RecordDefinition/RecordOccurrence/RecordHolder (definição
/// separada da ocorrência). `holderType`/`holderId` = referência genérica controlada.
model RecordBook {
  id            String   @id @default(uuid(7)) @db.Uuid
  gameWorldId   String   @db.Uuid
  recordCode    String // ex.: MOST_GOALS_SEASON
  scope         String   @default("WORLD") // WORLD | CLUB | COMPETITION
  holderType    String? // PLAYER | CLUB | STAFF
  holderId      String?  @db.Uuid
  clubId        String?  @db.Uuid
  competitionId String?  @db.Uuid
  seasonNumber  Int?
  valueNumeric  Decimal? @db.Decimal(18, 4)
  valueText     String?
  achievedAt    DateTime @default(now())

  @@index([gameWorldId, recordCode])
}

/// Linha de história do clube (append-only): título, acesso, rebaixamento, troca
/// de identidade, marco. Forma granular §6.3.11: HistoricalEvent/ClubHistoricalIdentityPeriod.
model ClubHistoryEntry {
  id            String   @id @default(uuid(7)) @db.Uuid
  gameWorldId   String   @db.Uuid
  clubId        String   @db.Uuid
  entryType     String // TITLE | PROMOTION | RELEGATION | IDENTITY_CHANGE | MILESTONE
  seasonNumber  Int?
  competitionId String?  @db.Uuid
  title         String
  detailJson    Json?
  occurredAt    DateTime @default(now())

  @@index([gameWorldId, clubId])
}

/// Carreira do jogador (append-only): passagens por clube e marcos. Substitui a
/// visão introdutória `PlayerClubHistory` (§3.3). Forma granular §6.3.11:
/// PlayerCareerMilestone. Referência escalar (projeção histórica — §6.4).
model PlayerCareerHistory {
  id             String   @id @default(uuid(7)) @db.Uuid
  gameWorldId    String   @db.Uuid
  playerId       String   @db.Uuid
  clubId         String?  @db.Uuid
  entryType      String   @default("CLUB_SPELL") // CLUB_SPELL | MILESTONE | AWARD | RETIREMENT
  joinedAtSeason Int?
  leftAtSeason   Int?
  appearances    Int      @default(0)
  goals          Int      @default(0)
  assists        Int      @default(0)
  detailJson     Json?
  reason         String?
  recordedAt     DateTime @default(now())

  @@index([gameWorldId, playerId])
}

/// Histórico de transferências (append-only): toda transferência concluída fica
/// registrada para sempre (INV-6 — jogador não some sem evento). Forma granular §6.3.8.
model TransferHistory {
  id               String         @id @default(uuid(7)) @db.Uuid
  gameWorldId      String         @db.Uuid
  playerId         String         @db.Uuid
  fromClubId       String?        @db.Uuid
  toClubId         String?        @db.Uuid
  type             TransferType
  status           TransferStatus @default(COMPLETED)
  currencyId       String         @db.Uuid
  transferFeeMinor BigInt         @default(0) // dinheiro em unidade mínima
  seasonNumber     Int?
  sourceOfferId    String?        @db.Uuid
  completedAt      DateTime       @default(now())

  @@index([gameWorldId, playerId])
  @@index([gameWorldId, toClubId])
}
