  endsAt              DateTime?
  version             Int               @default(1) // concorrência otimista (agregado C7 · estágio)

  competitionSeason CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  matches           Match[]

  @@index([competitionSeasonId])
