// -----------------------------------------------------------------------------
// DISCIPLINA / SUSPENSÕES (A-13) — world-scoped, escopo competitivo opcional.
// -----------------------------------------------------------------------------

/// Suspensão de um jogador (A-13). `competitionSeasonId` delimita o escopo (NULL =
/// global). FK composta world-scoped ao Player. `matchesServed` avança até
/// `matchesTotal`; `status` percorre PENDING→ACTIVE→SERVED (ou CANCELLED).
model PlayerSuspension {
  id                  String           @id @default(uuid(7)) @db.Uuid
  gameWorldId         String           @db.Uuid
  playerId            String           @db.Uuid
  competitionSeasonId String?          @db.Uuid // escopo competitivo (NULL = global); ref. escalar a CompetitionSeason
  reason              String
  matchesTotal        Int
  matchesServed       Int              @default(0)
  status              SuspensionStatus @default(PENDING)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  version             Int              @default(1)

  player Player @relation(fields: [gameWorldId, playerId], references: [gameWorldId, id], onDelete: Cascade)

  @@index([gameWorldId, playerId])
  @@index([gameWorldId, competitionSeasonId])
}

/// Contador de cartões acumulados por jogador/competição (A-13). Deriva de
/// `MatchEvent` (YELLOW_CARD/RED_CARD) mas é materializado para aplicar a regra de
/// suspensão por acúmulo sem varrer o feed. 1 linha por (mundo, jogador, edição).
model PlayerCompetitionDiscipline {
  id                  String @id @default(uuid(7)) @db.Uuid
  gameWorldId         String @db.Uuid
  playerId            String @db.Uuid
  competitionSeasonId String @db.Uuid // ref. escalar a CompetitionSeason (escopo do acúmulo)
  yellowAccumulated   Int    @default(0)
  redCount            Int    @default(0)
  version             Int    @default(1)

  player Player @relation(fields: [gameWorldId, playerId], references: [gameWorldId, id], onDelete: Cascade)

  @@unique([gameWorldId, playerId, competitionSeasonId]) // 1 contador por jogador/edição
  @@index([gameWorldId, competitionSeasonId])
}

