/// Presença operacional no elenco — NÃO substitui contrato/registro/empréstimo.
model Squad {
  id               String            @id @default(uuid(7)) @db.Uuid
  gameWorldId      String            @db.Uuid
  clubId           String            @db.Uuid
  name             String
  type             SquadType         @default(SENIOR)
  category         SquadCategory     @default(FIRST_TEAM)
  youthAgeCategory YouthAgeCategory?
  seasonNumber     Int
  version          Int               @default(1)

  club        Club              @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id], onDelete: Cascade)
  memberships SquadMembership[]

  @@unique([gameWorldId, id])
  @@index([gameWorldId, clubId])
}

model SquadMembership {
  id          String    @id @default(uuid(7)) @db.Uuid
  squadId     String    @db.Uuid
  playerId    String    @db.Uuid
  role        String?
  shirtNumber Int?
  isActive    Boolean   @default(true)
  /// Data de MUNDO, não instante de plataforma — R-190.
  ///
  /// Era `DateTime @default(now())`: relógio de plataforma governando fato de
  /// jogo. Quando um jogador entrou no elenco é regra (janela, elegibilidade),
  /// não auditoria. `DATE` e sem default, porque um default de relógio inventa a
  /// data e mata o replay (R-177).
  startsAt    DateTime  @db.Date
  endsAt      DateTime? @db.Date

  squad  Squad  @relation(fields: [squadId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([squadId, playerId])
  @@index([playerId])
}

