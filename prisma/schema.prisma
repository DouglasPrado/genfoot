// =============================================================================
// PLATAFORMA (globais, sem gameWorldId) — §3.1 / §6.3.1
// =============================================================================

/// Catálogo de moedas — R-181/R-191.
///
/// Existia como 17 colunas `currencyId @db.Uuid` apontando para o nada; o próprio
/// schema admitia "referencia a **futura** entidade Currency". É global (sem
/// `gameWorldId`): a moeda-base do mundo é escolhida daqui, e o dinheiro é sempre
/// `BigInt` em unidade mínima nela (R-181). `minorUnits` diz quantas casas
/// decimais a unidade mínima representa — 2 para o Real (centavos).
model Currency {
  id         String   @id @db.Uuid
  code       String   @unique // ISO-like: "BRL"
  name       String
  symbol     String
  minorUnits Int      @default(2)
  createdAt  DateTime @default(now())

  worlds           GameWorld[]
  financialAccounts FinancialAccount[]
  journalEntries   JournalEntry[]
  journalLines     JournalLine[]
}

/// Conta global do usuário. NÃO controla clube diretamente — o controle ocorre
/// por `ClubControl` dentro de um mundo. Forma canônica granular: UserAccount.
model UserAccount {
  id          String            @id @default(uuid(7)) @db.Uuid
  status      UserAccountStatus @default(ACTIVE)
  name        String
  email       String            @unique // e-mail normalizado: 1 conta por e-mail
  // R-171: identidade externa (Clerk). `sub` do token verificado — chave
  // estável de ligação com o provedor. O e-mail NÃO serve para isso: muda ao
  // longo da vida da conta e só chega no token via claim customizada.
  // Opcional porque contas podem nascer por outros caminhos (seed, admin).
  externalSubject String?         @unique
  role        UserRole          @default(PLAYER)
  avatarUrl   String?
  lastLoginAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  version     Int               @default(1)

  sessions            UserSession[]
  worldParticipations WorldParticipant[]
  notifications       Notification[]
  credential          UserCredential? // C-12: autenticação
  refreshTokens       AuthRefreshToken[] // C-12: rotação/detecção de reuso
}

model UserSession {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  gameWorldId String?  @db.Uuid
  isOnline    Boolean  @default(false) // habilita interação na partida ao vivo
  lastSeenAt  DateTime @default(now())
  device      String?
  ipAddress   String?

  user  UserAccount @relation(fields: [userId], references: [id])
  world GameWorld?  @relation(fields: [gameWorldId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([gameWorldId])
}

/// Vínculo usuário <-> mundo (§6.3.1). Substitui a antiga visão `ClubUser`.
///
/// R-177: o tempo do mundo é DATA, não instante — `@db.Date`, e sem
/// `@default(now())`: a data vem do domínio. Um default de relógio de máquina
/// inventaria a data quando o domínio esquecesse de mandá-la, e o mundo
/// deixaria de ser reproduzível (R-182).
model WorldParticipant {
  id          String                 @id @db.Uuid
  gameWorldId String                 @db.Uuid
  userId      String                 @db.Uuid
  status      WorldParticipantStatus @default(ACTIVE)
  joinedOn    DateTime               @db.Date
  leftOn      DateTime?              @db.Date
  // Cooldown de conta é responsabilidade de C1 (context map:66) mas NÃO é
  // aggregate root (:67 lista seis, e ele não está lá). É 1 por (conta, mundo)
  // = 1 por participação: cabe como atributo. Tabela própria inventaria um root
  // que o canônico não tem. O histórico fica no DomainEventLog (R-176).
  cooldownUntilOn DateTime?          @db.Date
  version     Int                    @default(1)

  gameWorld    GameWorld     @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)
  user         UserAccount   @relation(fields: [userId], references: [id])
  clubControls ClubControl[]
  clubEntryReservations ClubEntryReservation[]

  @@unique([gameWorldId, userId]) // 1 participação por usuário/mundo
  @@unique([gameWorldId, id])
  @@index([gameWorldId])
}

// -----------------------------------------------------------------------------
// AUTENTICAÇÃO / RBAC / AUDITORIA (C-12 · §6.3.1 / R-85/R-87)
// Materializa no schema o que antes só existia em doc: credencial local
// (Argon2id — R-85), rotação de refresh token com detecção de reuso, e RBAC
// granular (Permission/RolePermission) sobre os 6 níveis do R-87 (UserRole).
// -----------------------------------------------------------------------------

/// Credencial local do usuário (1:1 com UserAccount). `algo` default argon2id (R-85).
model UserCredential {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  algo         String   @default("argon2id")
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user UserAccount @relation(fields: [userId], references: [id])
}

/// Refresh token rotacionável. `family` agrupa a linhagem; `rotatedFromId` liga
/// ao token anterior — reuso de um token já rotacionado indica roubo (revoga a família).
model AuthRefreshToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique
  family        String
  rotatedFromId String?   @db.Uuid
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  user UserAccount @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([family])
}

/// Permissão granular nomeada (RBAC). `key` estável (ex.: WORLD.CALENDAR.EXECUTE).
model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  key         String  @unique
  description String?

  rolePermissions RolePermission[]
}

/// Concessão de uma permissão a um papel (UserRole). Grão de autorização do R-87.
model RolePermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  role         UserRole
  permissionId String   @db.Uuid

  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@index([permissionId])
}

// =============================================================================
// MUNDO E TEMPORADA — §3.1 / §6.3.2
// =============================================================================

/// Raiz de partição do mundo: seu `id` é o valor de `gameWorldId` dos filhos.
/// R-182. O que muda, e por quê:
///
/// - **`seed` e `startDate` passam a existir.** Não tinham coluna, e o
///   determinismo e o replay são invariante canônica (context map:149): sem
///   seed gravado, o mundo NÃO é reproduzível a partir do banco. O
///   `GameWorldSnapshot` sempre os teve; era o físico que não.
/// - **`currentDate` e `startDate` viram DATE** (R-177): o tempo do mundo é
///   data, não instante.
/// - **`rulesetVersion` é semver, não FK.** O domínio usa `RulesetVersion`
///   ("1.0.0"); `currentRuleSetVersionId` apontava para uma tabela que não
///   existe. A coluna FK fica, sem escritor, até haver catálogo de ruleset.
/// - **`name`, `maxClubs`, `seasonDays`, `initialClubCashMinor` e `currencyId`
///   viram NULLABLE.** Eram NOT NULL e o domínio não os produz — ou seja,
///   nada conseguia inserir um mundo. R-182 já decidiu que eles são
///   configuração (`GameRuleConfig`/`GameEconomyConfig`), não atributo do
///   mundo; nullable é a dívida declarada até a config existir. Um default
///   inventado seria pior: gravaria como fato o que é chute.
model GameWorld {
  id                      String      @id @db.Uuid
  // Identidade do mundo, escrita pelo domínio. NÃO é configuração: o comentário
  // anterior dizia "pendente: vai para GameRuleConfig (R-182)" e extrapolava —
  // R-182 trata de `maxClubs`, `seasonDays`, `initialClubCashMinor` e dos
  // literais da gênese (dimensionamento), e `GameRuleConfig` é, por definição,
  // "atalho chave-valor para parâmetros simples de BALANCEAMENTO".
  name                    String?
  description             String?
  // A CHAVE do objeto no R2, não a URL: a URL pública é composta na borda a
  // partir de `R2_CDN_URL`. Guardar a URL assaria o CDN de outro projeto aqui.
  bannerKey               String?
  squarePhotoKey          String?
  seed                    String // R-182: sem ele não há replay
  startDate               DateTime    @db.Date
  status                  WorldStatus @default(CREATING)
  rulesetVersion          String // semver ("1.0.0"), como o domínio usa
  currentSeasonId         String?     @db.Uuid
  currentRuleSetVersionId String?     @db.Uuid // sem escritor: não há catálogo de ruleset
  currentDate             DateTime    @db.Date // data virtual do mundo (R-177)
  timezone                String      @default("America/Sao_Paulo")
  // Relógio do mundo (MUNDO-V1): quanto tempo REAL vale um dia lógico, e quando
  // o próximo dia dispara. É agendamento (infra), não simulação — o tempo do
  // mundo continua sendo `currentDate` (R-177). `nextTickAt` é relógio de parede.
  realSecondsPerDay       Int? // ex.: 14400 = cada dia lógico a cada 4h reais
  clockRunning            Boolean     @default(false)
  nextTickAt              DateTime? // quando o próximo dia lógico deve rodar
  maxClubs                Int? // pendente: GameRuleConfig (R-182)
  seasonDays              Int? // R-107 · pendente: GameRuleConfig
  initialClubCashMinor    BigInt? // pendente: GameEconomyConfig (R-182)
  currencyId              String?     @db.Uuid // moeda-base do mundo (R-181/R-191)
  createdAt               DateTime    @default(now())
  // R-182: o contador do mundo morava DENTRO da tabela de eventos
  // (`DomainEventLog.sequence`/`OutboxEvent.sequence`) e não tinha dono. É
  // daqui que sai o `worldSequence` de cada evento: o append incrementa esta
  // linha, e o lock dela é o que garante ordem total sem gap nem duplicata
  // (CA-REG-01).
  //
  // `seed` e `startDate` — o resto de R-182 — entram com a reescrita de C2, que
  // é quem cria mundo. Hoje o seed viaja como parâmetro e o mundo NÃO é
  // reproduzível a partir do banco.
  worldSequence           BigInt      @default(0)
  version                 Int         @default(1)

  currency          Currency?          @relation(fields: [currencyId], references: [id])
  seasons           Season[]
  clubs             Club[]
  persons           Person[]
  players           Player[]
  staffMembers      StaffMember[]
  competitions      Competition[]
  worldParticipants WorldParticipant[]
  sessions          UserSession[]
  economyConfig     GameEconomyConfig?
  economySnapshots  EconomySnapshot[]
  narratives        Narrative[]
  notifications     Notification[]
  auditLogs         GameAuditLog[]
  ruleConfigs       GameRuleConfig[]
}

model GameEconomyConfig {
  id                        String  @id @default(uuid(7)) @db.Uuid
  gameWorldId               String  @unique @db.Uuid
  basePlayerPriceMultiplier Decimal @db.Decimal(8, 4) // não-monetário: multiplicador
  baseWageMultiplier        Decimal @db.Decimal(8, 4)
  clubCountWeight           Decimal @db.Decimal(8, 4)
  activePlayerCountWeight   Decimal @db.Decimal(8, 4)
  retiredPlayerCountWeight  Decimal @db.Decimal(8, 4)
  freeAgentCountWeight      Decimal @db.Decimal(8, 4)
  moneySupplyWeight         Decimal @db.Decimal(8, 4)
  minGeneratedPlayerAge     Int
  maxGeneratedPlayerAge     Int
  targetPlayersPerClub      Int
  targetFreeAgentRatio      Decimal @db.Decimal(5, 4)
  inflationRatePerSeason    Decimal @default(0) @db.Decimal(6, 4)

  gameWorld GameWorld @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)
}

model EconomySnapshot {
  id                      String   @id @default(uuid(7)) @db.Uuid
  gameWorldId             String   @db.Uuid
  seasonId                String?  @db.Uuid
  currencyId              String   @db.Uuid
  totalClubs              Int
  totalActiveClubs        Int
  totalPlayers            Int
  totalActivePlayers      Int
  totalRetiredPlayers     Int
  totalFreeAgents         Int
  totalCashInWorldMinor   BigInt // dinheiro: unidade mínima
  averageClubCashMinor    BigInt
  averagePlayerValueMinor BigInt
  averageWageMinor        BigInt
  marketInflationIndex    Decimal  @db.Decimal(10, 4) // índices: não-monetários
  playerScarcityIndex     Decimal  @db.Decimal(10, 4)
  balanceScore            Decimal  @db.Decimal(10, 4)
  capturedAt              DateTime @default(now())

  gameWorld GameWorld @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)

  @@index([gameWorldId])
}

model Season {
  id          String       @id @default(uuid(7)) @db.Uuid
  gameWorldId String       @db.Uuid
  number      Int
  name        String
  status      SeasonStatus @default(PLANNED)
  startsAt    DateTime
  endsAt      DateTime?
  version     Int          @default(1)

  gameWorld GameWorld @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)

  @@unique([gameWorldId, number])
  @@unique([gameWorldId, id])
  @@index([gameWorldId])
}

// =============================================================================
// CLUBE — §3.2 / §6.3.3
// =============================================================================

/// R-175. `name`, `shortName` e `slug` NÃO moram aqui: a identidade do clube é
/// um PERÍODO com vigência (`ClubIdentityPeriod`), porque o rebranding (BC-003)
/// abre período novo em vez de sobrescrever. Guardá-los aqui faria cada troca
/// de nome apagar a anterior — e o histórico é justamente o que a feature
/// existe para manter.
///
/// O nome corrente é o período sem `effectiveThrough`. A unicidade de nome por
/// mundo vive lá, com índice parcial sobre o período vigente.
/// A identidade do clube ao longo do tempo (BC-003). Root canônico que não
/// tinha tabela — e sem ele o rebranding sobrescreveria o nome, apagando o
/// histórico que a feature existe para guardar.
///
/// O período vigente é o de `effectiveThrough = null`. "Nome único por mundo"
/// (context map:153) é índice único PARCIAL sobre os vigentes: dois clubes não
/// podem se chamar igual HOJE, mas um nome abandonado pode ser reusado.
model ClubIdentityPeriod {
  id               String    @id @db.Uuid
  gameWorldId      String    @db.Uuid
  clubId           String    @db.Uuid
  name             String
  shortCode        String
  effectiveFrom    DateTime  @db.Date
  effectiveThrough DateTime? @db.Date
  rulesetVersion   String
  // Identidade visual: opcional porque clube gerado nasce sem ela e o jogador a
  // define ao personalizar (BC-003). Cores em hex, kits/escudo por template.
  primaryColor      String?
  secondaryColor    String?
  tertiaryColor     String?
  homeKitTemplateId String?
  awayKitTemplateId String?
  crestTemplateId   String?

  club Club @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id], onDelete: Cascade)

  @@unique([gameWorldId, id])
  @@index([gameWorldId, clubId])
}

/// Root canônico (context map:77) que não tinha tabela — a única pista no
/// schema era `DepartmentType.STADIUM`, que é outro modelo: estádio-como-
/// departamento. O domínio o tem como ENTIDADE, obrigatória, 1 por clube.
model Stadium {
  id               String               @id @db.Uuid
  gameWorldId      String               @db.Uuid
  clubId           String               @db.Uuid
  name             String
  tenure           StadiumTenure
  capacity         Int
  pitchQuality     Int
  condition        Int
  licenseStatus    StadiumLicenseStatus @default(PENDING)
  maintenanceDueOn DateTime?            @db.Date
  version          Int                  @default(1)

  club Club @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id], onDelete: Cascade)

  @@unique([gameWorldId, id])
  // 1 estádio por clube: o domínio o tem como campo obrigatório, não lista.
  @@unique([gameWorldId, clubId])
}

enum StadiumTenure {
  OWNED
  LEASED
}

enum StadiumLicenseStatus {
  PENDING
  LICENSED
  SUSPENDED
}

/// Preço de ingresso vigente a partir de uma data (R-27).
model TicketPricePolicy {
  id             String   @id @db.Uuid
  gameWorldId    String   @db.Uuid
  clubId         String   @db.Uuid
  // R-181: dinheiro é BigInt em unidade mínima. O domínio usava `number`
  // (double IEEE-754) — muda com a reescrita de C9, que é dona do dinheiro.
  priceMinor     BigInt
  currencyId     String?  @db.Uuid // espera a model Currency (R-181)
  effectiveOn    DateTime @db.Date
  rulesetVersion String

  club Club @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id], onDelete: Cascade)

  @@unique([gameWorldId, id])
  @@index([gameWorldId, clubId, effectiveOn])
}

/// Contrato comercial sobre um ativo do clube (naming rights, patrocínio).
///
/// PENDENTE E DECLARADO: ele não sabe quanto vale. O domínio não tem valor nem
/// referência a valor — só `externalAgreementRef`. O dinheiro é do C9
/// (context map:78), mas sem sequer uma referência o patrocínio é contrato sem
/// preço. Volta com C9.
model CommercialAgreement {
  id                   String   @id @db.Uuid
  gameWorldId          String   @db.Uuid
  clubId               String   @db.Uuid
  asset                String
  exclusive            Boolean  @default(false)
  startsOn             DateTime @db.Date
  endsOn               DateTime @db.Date
  externalAgreementRef String
  rulesetVersion       String

  club Club @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id], onDelete: Cascade)

  @@unique([gameWorldId, id])
  @@index([gameWorldId, clubId])
}

/// Decisão registrada da diretoria.
///
/// NÃO é o `BoardPromise` canônico, e a diferença importa: o doc pede promessa
/// VERIFICÁVEL (command `MakePublicPromise`), e isto é auditoria — registra o
/// que foi decidido, sem nada a verificar depois. São conceitos distintos, e o
/// canônico segue sem materialização. Registrado como pendência.
model BoardDecision {
  id               String    @id @db.Uuid
  gameWorldId      String    @db.Uuid
  clubId           String    @db.Uuid
  decisionType     String
  authorId         String
  justification    String
  effectiveFrom    DateTime  @db.Date
  effectiveThrough DateTime? @db.Date
  recordedAt       DateTime  @db.Date
  rulesetVersion   String

  club Club @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id], onDelete: Cascade)

  @@unique([gameWorldId, id])
  @@index([gameWorldId, clubId])
}

model Club {
  id                  String          @id @db.Uuid
  gameWorldId         String          @db.Uuid
  regionId            String
  foundedYear         Int?
  // R-180: `controlType` saiu daqui também. Era projeção duplicada do
  // `ClubControl` — e duas fontes para "quem comanda" divergem em silêncio.
  // Clube sem controle ativo é tocado pela IA; a pergunta se responde no
  // ClubControl, não num flag do clube.
  status              ClubStatus      @default(ACTIVE)
  // O domínio tem BANDA de reputação, não dois escalares soltos.
  reputationBand      Int             @default(1)
  fanBaseSize         Int             @default(0)
  boardPatience       Int             @default(50)
  pressureLevel       Int             @default(0)
  // Dinheiro do clube: pendente. `cashMinor` é PROJEÇÃO do razão (Decisão
  // 19.10) e não pode ser escrito por C3 — o clube nunca escreve LedgerEntry
  // (context map:78). Volta com C9, onde tem dono. `currencyId` espera a model
  // Currency, que não existe (R-181).
  currencyId          String?         @db.Uuid
  cashMinor           BigInt?
  wageBudgetMinor     BigInt?
  transferBudgetMinor BigInt?
  version             Int             @default(1)

  gameWorld         GameWorld              @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)
  identityPeriods   ClubIdentityPeriod[]
  stadium           Stadium?
  ticketPolicies    TicketPricePolicy[]
  commercialAgreements CommercialAgreement[]
  boardDecisions    BoardDecision[]
  controls          ClubControl[]
  entryReservations ClubEntryReservation[]
  departments       ClubDepartment[]
  aiProfile         ClubAIProfile?
  // `players` saiu daqui junto com `Player.clubId` (R-189): a relação existia
  // só para a FK duplicada. Quem diz o elenco do clube é `squads`.
  playerContracts   PlayerContract[]
  staffContracts    StaffContract[]
  trainingPlans     TrainingPlan[]
  squads            Squad[]
  scoutReports      ScoutReport[]
  transferListings  TransferListing[]
  finances          FinancialTransaction[]
  financeSnapshots  ClubFinanceSnapshot[]
  financialAccounts FinancialAccount[] // razão de partidas dobradas (§6.3.9)
  automationRules   AutomationRule[]
  seasonStats       ClubSeasonStats[]
  homeMatches       Match[]                @relation("HomeClubMatches")
  awayMatches       Match[]                @relation("AwayClubMatches")
  offersBuying      Offer[]                @relation("BuyingClubOffers")
  offersSelling     Offer[]                @relation("SellingClubOffers")

  // A unicidade de nome mudou de casa: ela é do PERÍODO vigente
  // (ClubIdentityPeriod), como índice único parcial em SQL cru. Aqui ela não
  // cabia — o clube não tem mais nome, tem história de nomes.
  @@unique([gameWorldId, id]) // par de referência para FKs compostas por mundo
  @@index([gameWorldId])
}

/// Controle atual ou histórico do clube por um participante do mundo.
/// Invariante (índice único parcial em migration SQL): 1 controle ACTIVE por clube.
/// Quem comanda o clube, e desde quando.
///
/// R-177: `startsAtWorldTick`/`endsAtWorldTick` viraram DATA. Eram o único par
/// de colunas `*WorldTick` do schema inteiro, e não existia conversor data↔tick
/// em lado nenhum — o domínio sempre foi `YYYY-MM-DD`.
///
/// R-180: `controlType` saiu. Clube sem `ClubControl` ativo é tocado pela IA.
/// O enum era incoerente com a própria tabela: `controlType = AI` exigiria um
/// `WorldParticipant` fantasma, porque `worldParticipantId` é NOT NULL.
///
/// `endedReason` passa a existir: `ClubControlEndedEvent.reason` é obrigatório
/// no domínio e não tinha coluna — o motivo evaporava na gravação.
/// Retenção temporária da vaga num clube, com TTL (R-25).
///
/// Root canônico que não tinha tabela: 9 campos sem destino, e a reserva vivia
/// dentro do blob de identidade do mundo. Não era detalhe de gravação —
/// expirar reserva varrendo um blob JSON não é o mesmo produto que expirar por
/// índice em `expiresOn`, que é o que `@@index([status, expiresOn])` dá.
///
/// "1 reserva HELD por clube" é índice único PARCIAL, em SQL cru na migration.
/// Já "não reservar clube com controle ativo" cruza agregados e não vira
/// constraint: fica no caso de uso, com o índice parcial do `ClubControl` como
/// árbitro final na hora de confirmar. A reserva é retenção mole com prazo; a
/// vaga só é de fato tomada quando o controle nasce.
model ClubEntryReservation {
  id                 String                     @id @db.Uuid
  gameWorldId        String                     @db.Uuid
  clubId             String                     @db.Uuid
  worldParticipantId String                     @db.Uuid
  status             ClubEntryReservationStatus @default(HELD)
  heldOn             DateTime                   @db.Date
  expiresOn          DateTime                   @db.Date
  version            Int                        @default(1)

  club             Club             @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id], onDelete: Cascade)
  worldParticipant WorldParticipant @relation(fields: [gameWorldId, worldParticipantId], references: [gameWorldId, id], onDelete: Cascade)

  @@unique([gameWorldId, id])
  @@index([gameWorldId, clubId])
  @@index([gameWorldId, worldParticipantId])
  // O varredor de vencidas acha as suas por índice, não lendo o mundo inteiro.
  @@index([status, expiresOn])
}

model ClubControl {
  id                 String            @id @db.Uuid
  gameWorldId        String            @db.Uuid
  clubId             String            @db.Uuid
  worldParticipantId String            @db.Uuid
  status             ClubControlStatus @default(ACTIVE)
  startsOn           DateTime          @db.Date
  endedOn            DateTime?         @db.Date
  endedReason        String?
  version            Int               @default(1)

  club Club @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id], onDelete: Cascade)
  // FK composta world-scoped (Decisão 19.8). Era simples (`references: [id]`) —
  // o mesmo defeito que `StaffContract.club` ainda tem.
  worldParticipant WorldParticipant @relation(fields: [gameWorldId, worldParticipantId], references: [gameWorldId, id], onDelete: Cascade)

  @@unique([gameWorldId, id])
  @@index([gameWorldId, clubId])
  @@index([gameWorldId, worldParticipantId])
  // "1 controle ativo por clube" precisa de índice único PARCIAL
  // (`WHERE status = 'ACTIVE'`), que o Prisma não expressa. Vai como SQL cru na
  // migration — é um dos casos que o gate DB-01..DB-16 antecipa.
}

/// Departamento do clube. FILHO do `Club`, não root.
///
/// O context map (:77) o lista como aggregate root, mas o domínio o tem dentro
/// do `Club` — `Club.setDepartmentPlan` o muta, ou seja, ele está na fronteira
/// de consistência do clube. E R-175 quebrou o mega-agregado por CONTENÇÃO, que
/// aqui não existe: ninguém disputa o departamento de um clube com outro clube.
/// Um departamento sem clube não existe.
///
/// Por isso `version` some: quem versiona é o `Club`, e dois contadores para o
/// mesmo commit é convite para divergirem.
///
/// `targetLevel`/`capacity`/`condition`/`maintenanceDueOn` vêm do domínio;
/// `maxLevel` vem do schema e FICA — sem ele a invariante canônica
/// `level ≤ maxLevel` (doc:154) é inexprimível, e era.
model ClubDepartment {
  // Sem `id`: o departamento não tem identidade própria no domínio — ele É o
  // par (clube, tipo), e ninguém o referencia por id (o InfrastructureProject
  // aponta o alvo pelo `kind`). Um uuid sintético aqui seria cerimônia: uma
  // chave que nada usa e que o agregado teria de inventar a cada save.
  gameWorldId      String         @db.Uuid
  clubId           String         @db.Uuid
  type             DepartmentType
  level            Int            @default(1)
  targetLevel      Int            @default(1)
  maxLevel         Int            @default(5)
  capacity         Int            @default(0)
  condition        Int            @default(100)
  maintenanceDueOn DateTime?      @db.Date
  // Custos e moeda: pendente. Dinheiro é do C9 — o clube nunca escreve
  // LedgerEntry (context map:78). Voltam com ele.
  currencyId                    String? @db.Uuid
  maintenanceCostPerSeasonMinor BigInt?
  upgradeCostMinor              BigInt?
  effectJson                    Json?

  club Club @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id], onDelete: Cascade)

  // A chave natural É a chave primária: um clube tem no máximo um departamento
  // de cada tipo, e isso deixa de ser convenção para virar constraint.
  @@id([gameWorldId, clubId, type])
}

model ClubAIProfile {
  id                   String @id @default(uuid(7)) @db.Uuid
  clubId               String @unique @db.Uuid
  aggressiveness       Int    @default(50)
  patience             Int    @default(50)
  youthPreference      Int    @default(50)
  transferRisk         Int    @default(50)
  financialDiscipline  Int    @default(50)
  tacticalFlexibility  Int    @default(50)
  substitutionTiming   Int    @default(50)
  injuryRiskTolerance  Int    @default(50)
  offlineDecisionLevel Int    @default(1)
  strategyJson         Json?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

// =============================================================================
// PESSOA E JOGADOR (separados — canônico) — §3.3 / §6.3.4
// =============================================================================

/// Dados pessoais/biográficos de qualquer indivíduo único do mundo.
model Person {
  id          String       @id @default(uuid(7)) @db.Uuid
  gameWorldId String       @db.Uuid
  firstName   String
  lastName    String
  knownName   String?
  nationality String
  birthDate   DateTime
  ageVirtual  Int
  gender      Gender       @default(MALE)
  // M-02 nota: `Person.status` é de CARREIRA/ciclo-de-vida da pessoa (ACTIVE/RETIRED/
  // FREE_AGENT), NÃO disponibilidade esportiva. A indisponibilidade de jogo vive em
  // `Player.availability`; não foi replicada aqui (Person pode ser staff, sem jogo).
  status      PlayerStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  version     Int          @default(1)

  gameWorld   GameWorld    @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)
  player      Player?
  staffMember StaffMember?

  @@unique([gameWorldId, id])
  @@index([gameWorldId])
}

/// Papel esportivo/atributos. `personId` é obrigatório e único por mundo —
/// a mesma pessoa reusa `Person` ao mudar de papel.
model Player {
  id                      String                 @id @default(uuid(7)) @db.Uuid
  gameWorldId             String                 @db.Uuid
  personId                String                 @unique @db.Uuid
  // `clubId` morreu aqui — R-189. O canon já dizia que `PlayerContract` é a
  // fonte autoritativa do vínculo jogador↔clube (`02-modelo-de-dados.md:57`), e
  // isto dizia o mesmo fato por outro caminho: a duplicata que a R-180 matou em
  // `Club.controlType`. O elenco (`Squad`/`SquadMembership`) diz por quem o
  // jogador joga; o contrato dirá de quem ele é, quando C9 materializar dinheiro.
  primaryPosition         PlayerPosition
  secondaryPosition       PlayerPosition?
  dominantFoot            DominantFoot
  heightCm                Int?
  weightKg                Int?
  status                  PlayerStatus           @default(ACTIVE)
  generationSource        PlayerGenerationSource
  generatedAtSeasonNumber Int?
  availability            PlayerAvailability     @default(AVAILABLE) // M-02: disponibilidade esportiva (separada da carreira em `status`)
  currentAbility          Int
  potentialAbility        Int
  /// Dinheiro do jogador — NULO até C9 existir (R-189).
  ///
  /// Eram NOT NULL, e isso tornava impossível materializar um jogador sem
  /// inventar valor. `0` não é "barato", é MENTIRA: diria que o jogador não vale
  /// nada. Nulo diz a verdade — ainda não se sabe.
  ///
  /// E não é preguiça: o GDD §1 proíbe gerar dinheiro "de forma isolada", fora da
  /// economia fechada. Preço e salário se calculam "considerando o equilíbrio de
  /// todo o universo", que é C9. Mesmo motivo do grid de goleiro em quem não é
  /// goleiro (R-188): nulo é "não se aplica ainda", zero é uma afirmação falsa.
  currencyId              String?                @db.Uuid
  marketValueMinor        BigInt?
  wageExpectationMinor    BigInt?
  // estado dinâmico
  morale                  Int                    @default(50)
  confidence              Int                    @default(50)
  happiness               Int                    @default(50)
  fatigue                 Int                    @default(0)
  matchSharpness          Int                    @default(50)
  /// Até que dia do mundo o jogador já foi processado (`Player.processUntil`).
  ///
  /// Faltava: o agregado tinha o estado e o físico não tinha onde guardá-lo, e
  /// o adapter só descobriu ao tentar reidratar. Sem ele o decaimento diário
  /// reprocessa desde sempre a cada carga.
  ///
  /// `DATE` sem default — é data de MUNDO (R-177), e um `now()` aqui inventaria
  /// a data e mataria o replay.
  lastProcessedOn         DateTime               @db.Date
  // traços persistentes
  //
  // `consistency` saiu deste bloco (R-188): é a "regularidade" da §2 do GDD —
  // atributo MENTAL, que sobe com treino, e mora no grid. Traço tem intensidade
  // e visibilidade; regularidade não tem nem uma nem outra.
  //
  // Os que sobraram aqui seguem divergentes em três lugares ao mesmo tempo —
  // este bloco, `PlayerPersonality` (com outros nomes) e a lista canônica do
  // GDD. R-188 registra a pendência e não a resolve.
  injuryProneness         Int                    @default(50)
  ambition                Int                    @default(50)
  loyalty                 Int                    @default(50)
  professionalism         Int                    @default(50)
  version                 Int                    @default(1)

  gameWorld             GameWorld                     @relation(fields: [gameWorldId], references: [id], onDelete: Cascade)
  person                Person                        @relation(fields: [gameWorldId, personId], references: [gameWorldId, id]) // C-05: FK composta world-scope, onDelete: Cascade)
  attributes            PlayerAttributes?
  background            PlayerBackground?
  personality           PlayerPersonality?
  development           PlayerDevelopment?
  developmentAccruals   PlayerDevelopmentAccrual[] // buffer de accrual (doc 13 §5.2)
  contracts             PlayerContract[]
  injuries              PlayerInjury[]
  scoutReports          ScoutReport[]
  transferListings      TransferListing[]
  offers                Offer[]
  squadMemberships      SquadMembership[]
  seasonStats           PlayerSeasonStats[]
  matchStats            PlayerMatchStats[]
  lineupPlayers         MatchLineupPlayer[]
  trainingEntries       TrainingPlayerEntry[]
  matchEvents           MatchEvent[]                  @relation("EventPlayer")
  relatedMatchEvents    MatchEvent[]                  @relation("EventRelatedPlayer")
  suspensions           PlayerSuspension[] // A-13
  competitionDiscipline PlayerCompetitionDiscipline[] // A-13

  @@unique([gameWorldId, personId])
  @@unique([gameWorldId, id])
}

/// O grid canônico do jogador — R-188.
///
/// **A lista é a do GDD §2, que se declara fonte única** (`02-sistema-de-jogadores.md:107`).
/// O que estava aqui era o grid do Football Manager, com os nomes dele
/// (`technique`, `flair`, `teamwork`, `workRate`, `aggression`) — e sem os do
/// GDD: bola parada, visão de jogo, explosão, recuperação física, regularidade,
/// resiliência, e 3 atributos de goleiro. A R-09 manda o `overall` ser "média
/// ponderada do **grid canônico**"; com o grid errado, ela não tinha sobre o que
/// operar, e o treino (§6) não tinha eixo.
///
/// Sem `id`: é filho de `Player` (1:1), não root — a régua de R-183/R-187. A
/// chave é o jogador.
///
/// **`overall` não é coluna**, e não é esquecimento: o GDD é explícito (`:120`)
/// — "derivado, não armazenado como atributo". Quem o deriva é
/// `player-overall.ts`.
model PlayerAttributes {
  playerId              String @id @db.Uuid
  // técnicos (12) — GDD §2
  finishing             Int // finalização
  longShots             Int // chute de longe
  shortPassing          Int // passe curto
  longPassing           Int // passe longo (lançamento)
  crossing              Int // cruzamento
  dribbling             Int // drible
  firstTouch            Int // controle de bola (domínio / primeiro toque)
  marking               Int // marcação
  tackling              Int // desarme
  heading               Int // cabeceio
  setPieces             Int // bola parada (falta / escanteio / pênalti)
  vision                Int // visão de jogo
  // físicos (9) — GDD §2
  pace                  Int // velocidade
  acceleration          Int // aceleração
  strength              Int // força
  stamina               Int // resistência
  jumping               Int // impulsão
  agility               Int // agilidade
  balance               Int // equilíbrio
  explosiveness         Int // explosão
  recovery              Int // recuperação física
  // mentais (10) — GDD §2. `positioning` é "inteligência tática (leitura de
  // jogo / posicionamento)": ler o jogo não é gesto técnico, e é onde o GDD o
  // põe. `aggression` NÃO está aqui — o GDD o classifica como traço
  // ("temperamento"), que tem visibilidade e não sobe com treino.
  positioning           Int // inteligência tática (leitura de jogo)
  decisions             Int // tomada de decisão
  concentration         Int // concentração / foco
  discipline            Int // disciplina
  composure             Int // frieza
  determination         Int // determinação / garra
  leadership            Int // liderança
  consistency           Int // regularidade
  bravery               Int // coragem
  resilience            Int // resiliência
  // goleiro (8, nullable — só GKs) — GDD §2, "grid próprio, somado aos
  // atributos físicos e mentais comuns"
  goalkeeperReflexes    Int? // reflexos
  goalkeeperPositioning Int? // posicionamento de gol
  goalkeeperHandling    Int? // saída de gol (domínio de área / cruzamentos)
  goalkeeperKicking     Int? // reposição com os pés
  goalkeeperAerial      Int? // jogo aéreo
  goalkeeperOneOnOne    Int? // um-contra-um
  goalkeeperPenalty     Int? // defesa de pênalti
  goalkeeperCommand     Int? // comando de área / comunicação

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

