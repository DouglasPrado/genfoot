  endsAt        DateTime?            @db.Date
  prizeJson     Json? // premiação (R-205)
  rulesJson     Json? // regras + qualificação (R-207)
  version       Int                  @default(1) // concorrência otimista (agregado C7 · edição)

  competition       Competition               @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  clubs             CompetitionClub[]
  stages            CompetitionStage[]
  matches           Match[]
  registrations     CompetitionRegistration[] // inscrições de clubes na edição (§6.3.7)
  clubSeasonStats   ClubSeasonStats[] // M-04: estatísticas de clube por competição
  playerSeasonStats PlayerSeasonStats[] // M-04: estatísticas de jogador por competição

