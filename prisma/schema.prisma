// =============================================================================
// PLATAFORMA (globais, sem gameWorldId) — §3.1 / §6.3.1
// =============================================================================

/// Conta global do usuário. NÃO controla clube diretamente — o controle ocorre
/// por `ClubControl` dentro de um mundo. Forma canônica granular: UserAccount.
model UserAccount {
  id          String            @id @default(uuid(7)) @db.Uuid
  status      UserAccountStatus @default(ACTIVE)
  name        String
  email       String            @unique // e-mail normalizado: 1 conta por e-mail
  // R-171: identidade externa (Clerk). `sub` do token verificado — chave
  // estável de ligação com o provedor. O e-mail NÃO serve para isso: muda ao
  // longo da vida da conta e só chega no token via claim customizada.
  // Opcional porque contas podem nascer por outros caminhos (seed, admin).
  externalSubject String?         @unique
  role        UserRole          @default(PLAYER)
  avatarUrl   String?
  lastLoginAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  version     Int               @default(1)

  sessions            UserSession[]
  worldParticipations WorldParticipant[]
  notifications       Notification[]
  credential          UserCredential? // C-12: autenticação
  refreshTokens       AuthRefreshToken[] // C-12: rotação/detecção de reuso
}

model UserSession {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  gameWorldId String?  @db.Uuid
  isOnline    Boolean  @default(false) // habilita interação na partida ao vivo
  lastSeenAt  DateTime @default(now())
  device      String?
  ipAddress   String?

  user  UserAccount @relation(fields: [userId], references: [id])
  world GameWorld?  @relation(fields: [gameWorldId], references: [id])

  @@index([userId])
  @@index([gameWorldId])
}

/// Vínculo usuário <-> mundo (§6.3.1). Substitui a antiga visão `ClubUser`.
///
/// R-177: o tempo do mundo é DATA, não instante — `@db.Date`, e sem
/// `@default(now())`: a data vem do domínio. Um default de relógio de máquina
/// inventaria a data quando o domínio esquecesse de mandá-la, e o mundo
/// deixaria de ser reproduzível (R-182).
model WorldParticipant {
  id          String                 @id @db.Uuid
  gameWorldId String                 @db.Uuid
  userId      String                 @db.Uuid
  status      WorldParticipantStatus @default(ACTIVE)
  joinedOn    DateTime               @db.Date
  leftOn      DateTime?              @db.Date
  version     Int                    @default(1)

  gameWorld    GameWorld     @relation(fields: [gameWorldId], references: [id])
  user         UserAccount   @relation(fields: [userId], references: [id])
  clubControls ClubControl[]

  @@unique([gameWorldId, userId]) // 1 participação por usuário/mundo
  @@unique([gameWorldId, id])
  @@index([gameWorldId])
}

// -----------------------------------------------------------------------------
// AUTENTICAÇÃO / RBAC / AUDITORIA (C-12 · §6.3.1 / R-85/R-87)
// Materializa no schema o que antes só existia em doc: credencial local
// (Argon2id — R-85), rotação de refresh token com detecção de reuso, e RBAC
// granular (Permission/RolePermission) sobre os 6 níveis do R-87 (UserRole).
// -----------------------------------------------------------------------------

/// Credencial local do usuário (1:1 com UserAccount). `algo` default argon2id (R-85).
model UserCredential {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @unique @db.Uuid
  passwordHash String
  algo         String   @default("argon2id")
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user UserAccount @relation(fields: [userId], references: [id])
}

/// Refresh token rotacionável. `family` agrupa a linhagem; `rotatedFromId` liga
/// ao token anterior — reuso de um token já rotacionado indica roubo (revoga a família).
model AuthRefreshToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique
  family        String
  rotatedFromId String?   @db.Uuid
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  user UserAccount @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([family])
}

/// Permissão granular nomeada (RBAC). `key` estável (ex.: WORLD.CALENDAR.EXECUTE).
model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  key         String  @unique
  description String?

  rolePermissions RolePermission[]
}

/// Concessão de uma permissão a um papel (UserRole). Grão de autorização do R-87.
model RolePermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  role         UserRole
  permissionId String   @db.Uuid

  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@index([permissionId])
}

// =============================================================================
// MUNDO E TEMPORADA — §3.1 / §6.3.2
// =============================================================================

/// Raiz de partição do mundo: seu `id` é o valor de `gameWorldId` dos filhos.
model GameWorld {
  id                      String      @id @default(uuid(7)) @db.Uuid
  name                    String
  status                  WorldStatus @default(CREATING)
  currentSeasonId         String?     @db.Uuid
  currentRuleSetVersionId String?     @db.Uuid // versão de ruleset vigente
  currentDate             DateTime // data virtual do mundo
  timezone                String      @default("America/Sao_Paulo")
  maxClubs                Int
  seasonDays              Int? // R-107: duração real da temporada por tamanho de mundo (16 clubes→~63d)
  initialClubCashMinor    BigInt // caixa inicial em unidade mínima
  currencyId              String      @db.Uuid // moeda-base do mundo (FK Currency)
  createdAt               DateTime    @default(now())
  version                 Int         @default(1)

  seasons           Season[]
  clubs             Club[]
  persons           Person[]
  players           Player[]
  staffMembers      StaffMember[]
  competitions      Competition[]
  worldParticipants WorldParticipant[]
  sessions          UserSession[]
  economyConfig     GameEconomyConfig?
  economySnapshots  EconomySnapshot[]
  narratives        Narrative[]
  notifications     Notification[]
  auditLogs         GameAuditLog[]
  ruleConfigs       GameRuleConfig[]
}

model GameEconomyConfig {
  id                        String  @id @default(uuid(7)) @db.Uuid
  gameWorldId               String  @unique @db.Uuid
  basePlayerPriceMultiplier Decimal @db.Decimal(8, 4) // não-monetário: multiplicador
  baseWageMultiplier        Decimal @db.Decimal(8, 4)
  clubCountWeight           Decimal @db.Decimal(8, 4)
  activePlayerCountWeight   Decimal @db.Decimal(8, 4)
  retiredPlayerCountWeight  Decimal @db.Decimal(8, 4)
  freeAgentCountWeight      Decimal @db.Decimal(8, 4)
  moneySupplyWeight         Decimal @db.Decimal(8, 4)
  minGeneratedPlayerAge     Int
  maxGeneratedPlayerAge     Int
  targetPlayersPerClub      Int
  targetFreeAgentRatio      Decimal @db.Decimal(5, 4)
  inflationRatePerSeason    Decimal @default(0) @db.Decimal(6, 4)

  gameWorld GameWorld @relation(fields: [gameWorldId], references: [id])
}

model EconomySnapshot {
  id                      String   @id @default(uuid(7)) @db.Uuid
  gameWorldId             String   @db.Uuid
  seasonId                String?  @db.Uuid
  currencyId              String   @db.Uuid
  totalClubs              Int
  totalActiveClubs        Int
  totalPlayers            Int
  totalActivePlayers      Int
  totalRetiredPlayers     Int
  totalFreeAgents         Int
  totalCashInWorldMinor   BigInt // dinheiro: unidade mínima
  averageClubCashMinor    BigInt
  averagePlayerValueMinor BigInt
  averageWageMinor        BigInt
  marketInflationIndex    Decimal  @db.Decimal(10, 4) // índices: não-monetários
  playerScarcityIndex     Decimal  @db.Decimal(10, 4)
  balanceScore            Decimal  @db.Decimal(10, 4)
  capturedAt              DateTime @default(now())

  gameWorld GameWorld @relation(fields: [gameWorldId], references: [id])

  @@index([gameWorldId])
}

model Season {
  id          String       @id @default(uuid(7)) @db.Uuid
  gameWorldId String       @db.Uuid
  number      Int
  name        String
  status      SeasonStatus @default(PLANNED)
  startsAt    DateTime
  endsAt      DateTime?
  version     Int          @default(1)

  gameWorld GameWorld @relation(fields: [gameWorldId], references: [id])

  @@unique([gameWorldId, number])
  @@unique([gameWorldId, id])
  @@index([gameWorldId])
}

// =============================================================================
// CLUBE — §3.2 / §6.3.3
// =============================================================================

model Club {
  id                  String          @id @default(uuid(7)) @db.Uuid
  gameWorldId         String          @db.Uuid
  name                String
  shortName           String
  slug                String
  city                String?
  country             String
  foundedYear         Int?
  controlType         ClubControlType @default(AI)
  status              ClubStatus      @default(ACTIVE)
  reputation          Int             @default(1)
  level               Int             @default(1)
  fanBaseSize         Int             @default(0)
  boardPatience       Int             @default(50)
  pressureLevel       Int             @default(0)
  currencyId          String          @db.Uuid // moeda operacional do clube (FK Currency)
  cashMinor           BigInt // C-06: PROJEÇÃO DERIVADA do razão (fonte de verdade = JournalLine POSTED, ownerScope=CLUB). NÃO é campo editável — reconstruído a partir do ledger.
  wageBudgetMinor     BigInt
  transferBudgetMinor BigInt
  version             Int             @default(1)

  gameWorld         GameWorld              @relation(fields: [gameWorldId], references: [id])
  controls          ClubControl[]
  departments       ClubDepartment[]
  aiProfile         ClubAIProfile?
  players           Player[]
  playerContracts   PlayerContract[]
  staffContracts    StaffContract[]
  trainingPlans     TrainingPlan[]
  squads            Squad[]
  scoutReports      ScoutReport[]
  transferListings  TransferListing[]
  finances          FinancialTransaction[]
  financeSnapshots  ClubFinanceSnapshot[]
  financialAccounts FinancialAccount[] // razão de partidas dobradas (§6.3.9)
  automationRules   AutomationRule[]
  seasonStats       ClubSeasonStats[]
  homeMatches       Match[]                @relation("HomeClubMatches")
  awayMatches       Match[]                @relation("AwayClubMatches")
  offersBuying      Offer[]                @relation("BuyingClubOffers")
  offersSelling     Offer[]                @relation("SellingClubOffers")

  @@unique([gameWorldId, slug])
  @@unique([gameWorldId, id]) // par de referência para FKs compostas por mundo
  @@index([gameWorldId])
}

/// Controle atual ou histórico do clube por um participante do mundo.
/// Invariante (índice único parcial em migration SQL): 1 controle ACTIVE por clube.
model ClubControl {
  id                 String          @id @default(uuid(7)) @db.Uuid
  gameWorldId        String          @db.Uuid
  clubId             String          @db.Uuid
  worldParticipantId String          @db.Uuid
  controlType        ClubControlType
  isActive           Boolean         @default(true)
  startsAtWorldTick  BigInt
  endsAtWorldTick    BigInt?
  version            Int             @default(1)

  club             Club             @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id])
  worldParticipant WorldParticipant @relation(fields: [worldParticipantId], references: [id])

  @@index([gameWorldId, clubId])
  @@index([worldParticipantId])
}

model ClubDepartment {
  id                            String         @id @default(uuid(7)) @db.Uuid
  gameWorldId                   String         @db.Uuid
  clubId                        String         @db.Uuid
  currencyId                    String         @db.Uuid
  type                          DepartmentType
  level                         Int            @default(1)
  maxLevel                      Int            @default(5)
  qualityScore                  Int            @default(10)
  maintenanceCostPerSeasonMinor BigInt
  upgradeCostMinor              BigInt
  effectJson                    Json?
  version                       Int            @default(1) // concorrência otimista (agregado C3)

  club Club @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id])

  @@unique([clubId, type])
  @@index([gameWorldId, clubId])
}

model ClubAIProfile {
  id                   String @id @default(uuid(7)) @db.Uuid
  clubId               String @unique @db.Uuid
  aggressiveness       Int    @default(50)
  patience             Int    @default(50)
  youthPreference      Int    @default(50)
  transferRisk         Int    @default(50)
  financialDiscipline  Int    @default(50)
  tacticalFlexibility  Int    @default(50)
  substitutionTiming   Int    @default(50)
  injuryRiskTolerance  Int    @default(50)
  offlineDecisionLevel Int    @default(1)
  strategyJson         Json?

  club Club @relation(fields: [clubId], references: [id])
}

// =============================================================================
// PESSOA E JOGADOR (separados — canônico) — §3.3 / §6.3.4
// =============================================================================

/// Dados pessoais/biográficos de qualquer indivíduo único do mundo.
model Person {
  id          String       @id @default(uuid(7)) @db.Uuid
  gameWorldId String       @db.Uuid
  firstName   String
  lastName    String
  knownName   String?
  nationality String
  birthDate   DateTime
  ageVirtual  Int
  gender      Gender       @default(MALE)
  // M-02 nota: `Person.status` é de CARREIRA/ciclo-de-vida da pessoa (ACTIVE/RETIRED/
  // FREE_AGENT), NÃO disponibilidade esportiva. A indisponibilidade de jogo vive em
  // `Player.availability`; não foi replicada aqui (Person pode ser staff, sem jogo).
  status      PlayerStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  version     Int          @default(1)

  gameWorld   GameWorld    @relation(fields: [gameWorldId], references: [id])
  player      Player?
  staffMember StaffMember?

  @@unique([gameWorldId, id])
  @@index([gameWorldId])
}

/// Papel esportivo/atributos. `personId` é obrigatório e único por mundo —
/// a mesma pessoa reusa `Person` ao mudar de papel.
model Player {
  id                      String                 @id @default(uuid(7)) @db.Uuid
  gameWorldId             String                 @db.Uuid
  personId                String                 @unique @db.Uuid
  clubId                  String?                @db.Uuid
  primaryPosition         PlayerPosition
  secondaryPosition       PlayerPosition?
  dominantFoot            DominantFoot
  heightCm                Int?
  weightKg                Int?
  status                  PlayerStatus           @default(ACTIVE)
  generationSource        PlayerGenerationSource
  generatedAtSeasonNumber Int?
  availability            PlayerAvailability     @default(AVAILABLE) // M-02: disponibilidade esportiva (separada da carreira em `status`)
  currentAbility          Int
  potentialAbility        Int
  currencyId              String                 @db.Uuid
  marketValueMinor        BigInt // dinheiro em unidade mínima
  wageExpectationMinor    BigInt
  // estado dinâmico
  morale                  Int                    @default(50)
  confidence              Int                    @default(50)
  happiness               Int                    @default(50)
  fatigue                 Int                    @default(0)
  matchSharpness          Int                    @default(50)
  // traços persistentes
  injuryProneness         Int                    @default(50)
  consistency             Int                    @default(50)
  ambition                Int                    @default(50)
  loyalty                 Int                    @default(50)
  professionalism         Int                    @default(50)
  version                 Int                    @default(1)

  gameWorld             GameWorld                     @relation(fields: [gameWorldId], references: [id])
  person                Person                        @relation(fields: [gameWorldId, personId], references: [gameWorldId, id]) // C-05: FK composta world-scoped
  club                  Club?                         @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id]) // C-05: FK composta world-scoped
  attributes            PlayerAttributes?
  background            PlayerBackground?
  personality           PlayerPersonality?
  development           PlayerDevelopment?
  developmentAccruals   PlayerDevelopmentAccrual[] // buffer de accrual (doc 13 §5.2)
  contracts             PlayerContract[]
  injuries              PlayerInjury[]
  scoutReports          ScoutReport[]
  transferListings      TransferListing[]
  offers                Offer[]
  squadMemberships      SquadMembership[]
  seasonStats           PlayerSeasonStats[]
  matchStats            PlayerMatchStats[]
  lineupPlayers         MatchLineupPlayer[]
  trainingEntries       TrainingPlayerEntry[]
  matchEvents           MatchEvent[]                  @relation("EventPlayer")
  relatedMatchEvents    MatchEvent[]                  @relation("EventRelatedPlayer")
  suspensions           PlayerSuspension[] // A-13
  competitionDiscipline PlayerCompetitionDiscipline[] // A-13

  @@unique([gameWorldId, personId])
  @@unique([gameWorldId, id])
  @@index([gameWorldId, clubId])
}

model PlayerAttributes {
  id                    String @id @default(uuid(7)) @db.Uuid
  playerId              String @unique @db.Uuid
  // técnicos
  finishing             Int
  longShots             Int
  heading               Int
  passing               Int
  crossing              Int
  dribbling             Int
  firstTouch            Int
  technique             Int
  tackling              Int
  marking               Int
  positioning           Int
  // físicos
  acceleration          Int
  pace                  Int
  stamina               Int
  strength              Int
  agility               Int
  balance               Int
  jumping               Int
  // mentais
  bravery               Int
  aggression            Int
  composure             Int
  decisions             Int
  concentration         Int
  leadership            Int
  teamwork              Int
  workRate              Int
  determination         Int
  flair                 Int
  // goleiro (nullable — só GKs)
  goalkeeperReflexes    Int?
  goalkeeperHandling    Int?
  goalkeeperPositioning Int?
  goalkeeperKicking     Int?
  goalkeeperOneOnOne    Int?

  player Player @relation(fields: [playerId], references: [id])
}

model PlayerBackground {
  id                    String  @id @default(uuid(7)) @db.Uuid
  playerId              String  @unique @db.Uuid
  childhoodPovertyLevel Int     @default(0)
  familyStability       Int     @default(50)
  violenceExposure      Int     @default(0)
  educationLevel        Int     @default(50)
  earlyFootballAccess   Int     @default(50)
  fatherPresenceScore   Int?
  motherPresenceScore   Int?
  guardianStory         String?
  lifeStorySummary      String?
  generatedTraitJson    Json? // traços derivados da história de vida

  player Player @relation(fields: [playerId], references: [id])
}

model PlayerPersonality {
  id                 String @id @default(uuid(7)) @db.Uuid
  playerId           String @unique @db.Uuid
  grit               Int
  emotionalStability Int
  discipline         Int
  ego                Int
  pressureHandling   Int
  adaptability       Int
  socialInfluence    Int
  mediaHandling      Int
  offFieldRisk       Int
  lifestyleBalance   Int
  hiddenTraits       Json? // traços ocultos, revelados por scouting

  player Player @relation(fields: [playerId], references: [id])
}

model PlayerDevelopment {
  id                      String    @id @default(uuid(7)) @db.Uuid
  playerId                String    @unique @db.Uuid
  technicalGrowthRate     Decimal   @db.Decimal(6, 4)
  physicalGrowthRate      Decimal   @db.Decimal(6, 4)
  mentalGrowthRate        Decimal   @db.Decimal(6, 4)
  peakAgeStart            Int
  peakAgeEnd              Int
  declineRate             Decimal   @db.Decimal(6, 4)
  trainingResponse        Int
  injuryImpactAccumulated Int       @default(0)
  lastDevelopmentAt       DateTime?

  player Player @relation(fields: [playerId], references: [id])
}

model PlayerContract {
  id                   String         @id @default(uuid(7)) @db.Uuid
  gameWorldId          String         @db.Uuid
  playerId             String         @db.Uuid
  clubId               String         @db.Uuid
  currencyId           String         @db.Uuid
  status               ContractStatus @default(ACTIVE)
  startSeason          Int
  endSeason            Int
  salaryPerSeasonMinor BigInt // dinheiro em unidade mínima
  signingBonusMinor    BigInt         @default(0)
  releaseClauseMinor   BigInt?
  moralePromiseJson    Json?
  roleInSquad          String?
  version              Int            @default(1)

  player Player @relation(fields: [gameWorldId, playerId], references: [gameWorldId, id])
  club   Club   @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id]) // C-05: FK composta world-scoped

  @@index([gameWorldId, playerId])
  @@index([clubId])
}

model PlayerInjury {
  id                           String         @id @default(uuid(7)) @db.Uuid
  gameWorldId                  String         @db.Uuid
  playerId                     String         @db.Uuid
  severity                     InjurySeverity
  name                         String
  description                  String?
  occurredAt                   DateTime
  expectedReturnAt             DateTime?
  recoveredAt                  DateTime?
  causedByMatchId              String?        @db.Uuid
  causedByTrainingPlanId       String?        @db.Uuid
  medicalDepartmentLevelAtTime Int?
  version                      Int            @default(1) // concorrência otimista (agregado C4 · medicina)

  player Player @relation(fields: [gameWorldId, playerId], references: [gameWorldId, id]) // C-05: FK composta world-scoped

  @@index([gameWorldId, playerId])
}

// -----------------------------------------------------------------------------
// DISCIPLINA / SUSPENSÕES (A-13) — world-scoped, escopo competitivo opcional.
// -----------------------------------------------------------------------------

/// Suspensão de um jogador (A-13). `competitionSeasonId` delimita o escopo (NULL =
/// global). FK composta world-scoped ao Player. `matchesServed` avança até
/// `matchesTotal`; `status` percorre PENDING→ACTIVE→SERVED (ou CANCELLED).
model PlayerSuspension {
  id                  String           @id @default(uuid(7)) @db.Uuid
  gameWorldId         String           @db.Uuid
  playerId            String           @db.Uuid
  competitionSeasonId String?          @db.Uuid // escopo competitivo (NULL = global); ref. escalar a CompetitionSeason
  reason              String
  matchesTotal        Int
  matchesServed       Int              @default(0)
  status              SuspensionStatus @default(PENDING)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  version             Int              @default(1)

  player Player @relation(fields: [gameWorldId, playerId], references: [gameWorldId, id])

  @@index([gameWorldId, playerId])
  @@index([gameWorldId, competitionSeasonId])
}

/// Contador de cartões acumulados por jogador/competição (A-13). Deriva de
/// `MatchEvent` (YELLOW_CARD/RED_CARD) mas é materializado para aplicar a regra de
/// suspensão por acúmulo sem varrer o feed. 1 linha por (mundo, jogador, edição).
model PlayerCompetitionDiscipline {
  id                  String @id @default(uuid(7)) @db.Uuid
  gameWorldId         String @db.Uuid
  playerId            String @db.Uuid
  competitionSeasonId String @db.Uuid // ref. escalar a CompetitionSeason (escopo do acúmulo)
  yellowAccumulated   Int    @default(0)
  redCount            Int    @default(0)
  version             Int    @default(1)

  player Player @relation(fields: [gameWorldId, playerId], references: [gameWorldId, id])

  @@unique([gameWorldId, playerId, competitionSeasonId]) // 1 contador por jogador/edição
  @@index([gameWorldId, competitionSeasonId])
}

// =============================================================================
// COMISSÃO TÉCNICA, TREINO E ELENCO — §3.4 / §6.3.5 / §6.3.6
// =============================================================================

model StaffMember {
  id                String           @id @default(uuid(7)) @db.Uuid
  gameWorldId       String           @db.Uuid
  personId          String           @unique @db.Uuid
  role              StaffRole
  qualityTier       StaffQualityTier
  abilityScore      Int
  potentialScore    Int
  reputation        Int              @default(1)
  tacticalKnowledge Int              @default(50)
  youthDevelopment  Int              @default(50)
  medicalKnowledge  Int              @default(50)
  negotiation       Int              @default(50)
  communication     Int              @default(50)
  discipline        Int              @default(50)
  dataAnalysis      Int              @default(50)
  version           Int              @default(1)

  gameWorld GameWorld       @relation(fields: [gameWorldId], references: [id])
  person    Person          @relation(fields: [gameWorldId, personId], references: [gameWorldId, id]) // C-05: FK composta world-scoped
  contracts StaffContract[]

  @@unique([gameWorldId, personId])
  @@unique([gameWorldId, id])
  @@index([gameWorldId])
}

model StaffContract {
  id                   String         @id @default(uuid(7)) @db.Uuid
  gameWorldId          String         @db.Uuid
  staffId              String         @db.Uuid
  clubId               String         @db.Uuid
  currencyId           String         @db.Uuid
  status               ContractStatus @default(ACTIVE)
  startSeason          Int
  endSeason            Int
  salaryPerSeasonMinor BigInt // dinheiro em unidade mínima
  version              Int            @default(1)

  staff StaffMember @relation(fields: [gameWorldId, staffId], references: [gameWorldId, id])
  club  Club        @relation(fields: [clubId], references: [id])

  @@index([gameWorldId, clubId])
  @@index([gameWorldId, staffId])
}

model TrainingPlan {
  id                String        @id @default(uuid(7)) @db.Uuid
  gameWorldId       String        @db.Uuid
  clubId            String        @db.Uuid
  seasonId          String        @db.Uuid
  name              String
  focus             TrainingFocus
  intensity         Int
  tacticalStyleJson Json?
  createdByStaffId  String?       @db.Uuid
  startsAt          DateTime
  endsAt            DateTime?

  club    Club                  @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id])
  entries TrainingPlayerEntry[]

  @@index([gameWorldId, clubId])
}

model TrainingPlayerEntry {
  id             String        @id @default(uuid(7)) @db.Uuid
  trainingPlanId String        @db.Uuid
  playerId       String        @db.Uuid
  focus          TrainingFocus
  workload       Int
  technicalGain  Decimal       @default(0) @db.Decimal(8, 4)
  physicalGain   Decimal       @default(0) @db.Decimal(8, 4)
  mentalGain     Decimal       @default(0) @db.Decimal(8, 4)
  fatigueGain    Int           @default(0)
  injuryRiskGain Int           @default(0)

  plan   TrainingPlan @relation(fields: [trainingPlanId], references: [id])
  player Player       @relation(fields: [playerId], references: [id])

  @@index([trainingPlanId])
  @@index([playerId])
}

/// Presença operacional no elenco — NÃO substitui contrato/registro/empréstimo.
model Squad {
  id               String            @id @default(uuid(7)) @db.Uuid
  gameWorldId      String            @db.Uuid
  clubId           String            @db.Uuid
  name             String
  type             SquadType         @default(SENIOR)
  category         SquadCategory     @default(FIRST_TEAM)
  youthAgeCategory YouthAgeCategory?
  seasonNumber     Int
  version          Int               @default(1)

  club        Club              @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id])
  memberships SquadMembership[]

  @@unique([gameWorldId, id])
  @@index([gameWorldId, clubId])
}

model SquadMembership {
  id          String    @id @default(uuid(7)) @db.Uuid
  squadId     String    @db.Uuid
  playerId    String    @db.Uuid
  role        String?
  shirtNumber Int?
  isActive    Boolean   @default(true)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?

  squad  Squad  @relation(fields: [squadId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([squadId, playerId])
  @@index([playerId])
}

// =============================================================================
// SCOUTING E MERCADO — §3.5 / §6.3.8
// =============================================================================

model ScoutReport {
  id                        String    @id @default(uuid(7)) @db.Uuid
  gameWorldId               String    @db.Uuid
  clubId                    String    @db.Uuid
  playerId                  String    @db.Uuid
  scoutStaffId              String?   @db.Uuid
  currencyId                String    @db.Uuid
  accuracy                  Int
  estimatedCurrentAbility   Int
  estimatedPotentialAbility Int
  estimatedMarketValueMinor BigInt // dinheiro em unidade mínima
  personalityNotes          String?
  backgroundNotes           String?
  recommendationScore       Int
  discoveredAt              DateTime  @default(now())
  expiresAt                 DateTime?
  version                   Int       @default(1) // concorrência otimista (agregado C6 · scouting)

  club   Club   @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id])
  player Player @relation(fields: [gameWorldId, playerId], references: [gameWorldId, id]) // C-05: FK composta world-scoped

  @@index([gameWorldId, clubId])
  @@index([playerId])
}

model TransferListing {
  id               String         @id @default(uuid(7)) @db.Uuid
  gameWorldId      String         @db.Uuid
  clubId           String         @db.Uuid
  playerId         String         @db.Uuid
  currencyId       String         @db.Uuid
  status           TransferStatus @default(LISTED)
  type             TransferType
  askingPriceMinor BigInt // dinheiro em unidade mínima
  listedAt         DateTime       @default(now())
  expiresAt        DateTime?
  reason           String?
  version          Int            @default(1) // concorrência otimista (agregado C6)

  club   Club    @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id])
  player Player  @relation(fields: [gameWorldId, playerId], references: [gameWorldId, id]) // C-05: FK composta world-scoped
  offers Offer[]

  @@index([gameWorldId, clubId])
  @@index([playerId])
}

/// Oferta de transferência (TransferOffer). Detalhamento canônico como processo
/// (TransferCase + versões de oferta, parcelas, cláusulas) em §6.3.8 do doc.
model Offer {
  id                       String                  @id @default(uuid(7)) @db.Uuid
  gameWorldId              String                  @db.Uuid
  listingId                String?                 @db.Uuid
  playerId                 String                  @db.Uuid
  buyingClubId             String                  @db.Uuid
  sellingClubId            String?                 @db.Uuid
  currencyId               String                  @db.Uuid
  status                   TransferStatus          @default(NEGOTIATING)
  type                     TransferType
  transferFeeMinor         BigInt // dinheiro em unidade mínima
  salaryOfferMinor         BigInt
  contractSeasons          Int
  loanPurchaseClauseType   LoanPurchaseClauseType? @default(NONE)
  bonusJson                Json?
  clausesJson              Json?
  playerInterestScore      Int?
  sellingClubInterestScore Int?
  buyingClubNeedScore      Int?
  version                  Int                     @default(1) // concorrência otimista (agregado C6 · TransferCase)

  listing     TransferListing? @relation(fields: [listingId], references: [id])
  player      Player           @relation(fields: [gameWorldId, playerId], references: [gameWorldId, id])
  buyingClub  Club             @relation("BuyingClubOffers", fields: [buyingClubId], references: [id])
  sellingClub Club?            @relation("SellingClubOffers", fields: [sellingClubId], references: [id])

  @@index([gameWorldId, playerId])
  @@index([buyingClubId])
  @@index([listingId])
}

// =============================================================================
// FINANCEIRO — §3.6 / §6.3.9
// =============================================================================

/// Visão introdutória do lançamento financeiro. Modelo canônico de contabilidade
/// (partidas dobradas: FinancialJournalEntry/Line, débitos = créditos) em §6.3.9.
model FinancialTransaction {
  id           String                 @id @default(uuid(7)) @db.Uuid
  gameWorldId  String                 @db.Uuid
  clubId       String                 @db.Uuid
  currencyId   String                 @db.Uuid
  type         FinanceTransactionType
  description  String?
  amountMinor  BigInt // dinheiro em unidade mínima (proibido Float/Decimal)
  seasonNumber Int?
  occurredAt   DateTime               @default(now())
  metadata     Json?

  club Club @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id])

  @@index([gameWorldId, clubId])
}

model ClubFinanceSnapshot {
  id                    String @id @default(uuid(7)) @db.Uuid
  gameWorldId           String @db.Uuid
  clubId                String @db.Uuid
  seasonId              String @db.Uuid
  currencyId            String @db.Uuid
  cashMinor             BigInt // dinheiro em unidade mínima
  revenueMinor          BigInt
  expensesMinor         BigInt
  wagesMinor            BigInt
  transferSpentMinor    BigInt
  transferReceivedMinor BigInt
  debtMinor             BigInt @default(0)
  profitMinor           BigInt

  club Club @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id])

  @@unique([clubId, seasonId])
  @@index([gameWorldId, clubId])
}

// =============================================================================
// COMPETIÇÃO — §3.7 / §6.3.7
// =============================================================================

model Competition {
  id          String            @id @default(uuid(7)) @db.Uuid
  gameWorldId String            @db.Uuid
  name        String
  type        CompetitionType
  format      CompetitionFormat
  country     String?
  tier        Int?
  reputation  Int               @default(1)
  version     Int               @default(1) // concorrência otimista (agregado C7)

  gameWorld GameWorld           @relation(fields: [gameWorldId], references: [id])
  seasons   CompetitionSeason[]

  @@unique([gameWorldId, id])
  @@index([gameWorldId])
}

model CompetitionSeason {
  id            String       @id @default(uuid(7)) @db.Uuid
  competitionId String       @db.Uuid
  seasonId      String       @db.Uuid
  name          String
  status        SeasonStatus @default(PLANNED)
  startsAt      DateTime
  endsAt        DateTime?
  prizeJson     Json?
  rulesJson     Json? // regras flexíveis por competição
  version       Int          @default(1) // concorrência otimista (agregado C7 · edição)

  competition       Competition               @relation(fields: [competitionId], references: [id])
  clubs             CompetitionClub[]
  stages            CompetitionStage[]
  matches           Match[]
  registrations     CompetitionRegistration[] // inscrições de clubes na edição (§6.3.7)
  clubSeasonStats   ClubSeasonStats[] // M-04: estatísticas de clube por competição
  playerSeasonStats PlayerSeasonStats[] // M-04: estatísticas de jogador por competição

  @@unique([competitionId, seasonId])
}

model CompetitionClub {
  id                  String  @id @default(uuid(7)) @db.Uuid
  competitionSeasonId String  @db.Uuid
  clubId              String  @db.Uuid
  seed                Int?
  groupName           String?

  competitionSeason CompetitionSeason @relation(fields: [competitionSeasonId], references: [id])

  @@unique([competitionSeasonId, clubId])
}

model CompetitionStage {
  id                  String            @id @default(uuid(7)) @db.Uuid
  competitionSeasonId String            @db.Uuid
  name                String
  order               Int
  format              CompetitionFormat
  startsAt            DateTime?
  endsAt              DateTime?
  version             Int               @default(1) // concorrência otimista (agregado C7 · estágio)

  competitionSeason CompetitionSeason @relation(fields: [competitionSeasonId], references: [id])
  matches           Match[]

  @@index([competitionSeasonId])
}

// =============================================================================
// PARTIDA E SIMULAÇÃO — §3.8 / §6.3.7
// =============================================================================

model Match {
  id                  String             @id @default(uuid(7)) @db.Uuid
  gameWorldId         String             @db.Uuid
  competitionSeasonId String?            @db.Uuid
  stageId             String?            @db.Uuid
  homeClubId          String             @db.Uuid
  awayClubId          String             @db.Uuid
  seasonNumber        Int
  roundNumber         Int?
  scheduledAt         DateTime
  startedAt           DateTime?
  finishedAt          DateTime?
  runtimeStatus       MatchRuntimeStatus @default(SCHEDULED) // ciclo de vida
  resultStatus        MatchResultStatus  @default(PENDING) // desfecho
  homologationStatus  HomologationStatus @default(PENDING) // confirmação oficial
  homeGoals           Int                @default(0)
  awayGoals           Int                @default(0)
  homeExpectedGoals   Decimal?           @db.Decimal(8, 4) // xG: não-monetário
  awayExpectedGoals   Decimal?           @db.Decimal(8, 4)
  simulationSeed      String? // replay determinístico
  simulatedOffline    Boolean            @default(false) // + MatchControlSource
  version             Int                @default(1)

  competitionSeason CompetitionSeason?   @relation(fields: [competitionSeasonId], references: [id])
  stage             CompetitionStage?    @relation(fields: [stageId], references: [id])
  homeClub          Club                 @relation("HomeClubMatches", fields: [homeClubId], references: [id])
  awayClub          Club                 @relation("AwayClubMatches", fields: [awayClubId], references: [id])
  teamStates        MatchTeamState[]
  lineups           MatchLineup[]
  events            MatchEvent[]
  playerStats       PlayerMatchStats[]
  simulation        MatchSimulation?
  decisionPoints    MatchDecisionPoint[]

  @@index([gameWorldId])
  @@index([competitionSeasonId])
  @@index([homeClubId])
  @@index([awayClubId])
}

/// Cabeçalho do `SimulationManifest` imutável (I + R + A + s + C + hashes) — o
/// registro que permite replay bit-a-bit e auditoria (doc 15 §3). Uma vez que a
/// partida sai de PRE_MATCH (entradas congeladas) e FINISHED (commands fechados),
/// o manifesto NÃO muda; correção gera nova versão.
model MatchSimulation {
  id                    String  @id @default(uuid(7)) @db.Uuid
  gameWorldId           String  @db.Uuid
  matchId               String  @unique @db.Uuid
  engineVersion         String // identifica o kernel K (compatibilidade de replay)
  tickIntervalSeconds   Int // timestep canônico (PROPOSTO R-143: 60 s virtuais)
  totalTicks            Int
  homeStrengthSnapshot  Json // fotografia da força ofensiva/defensiva (parte de I)
  awayStrengthSnapshot  Json
  randomSeed            String // seed mestra s (determinismo)
  balanceJson           Json?
  finalMomentumJson     Json?
  // --- SimulationManifest: campos a adicionar (doc 15 §3.1) — PROPOSTO (R-145/R-146) ---
  rulesetVersionId      String? @db.Uuid // carimba R (ruleset da época) no kickoff (R-145)
  rngAlgorithm          String? // nomeia A (ex.: pcg32-xsh-rr) — R-146
  rngStreamsJson        Json? // seletores das streams por finalidade (R-146)
  contextSnapshot       Json? // clima/gramado/árbitro/torcida/importância/mando (I) — R-145
  lineupSnapshot        Json? // escalações congeladas e imutáveis no kickoff (I) — R-145
  inputHash             String? // hash de todo I (força+contexto+escalação+ruleset+rng+seed)
  homeStrengthHash      String? // hash por snapshot (isola qual entrada divergiu)
  awayStrengthHash      String?
  contextHash           String?
  lineupHash            String?
  resultHash            String? // hash do O (placar+eventos+série de ticks)
  hashAlgorithm         String? // nomeia a função de hash (ex.: sha256) — R-145
  manifestSchemaVersion Int? // versiona o formato do próprio manifesto — R-145
  version               Int     @default(1) // concorrência otimista durante a construção

  match      Match                 @relation(fields: [matchId], references: [id])
  ticks      MatchSimulationTick[]
  commandLog MatchCommandLog[] // C ordenado (doc 15 §3.2) — R-145
}

model MatchSimulationTick {
  id             String  @id @default(uuid(7)) @db.Uuid
  simulationId   String  @db.Uuid
  minute         Int
  second         Int?
  homeMomentum   Decimal @db.Decimal(8, 4)
  awayMomentum   Decimal @db.Decimal(8, 4)
  homeThreat     Decimal @db.Decimal(8, 4)
  awayThreat     Decimal @db.Decimal(8, 4)
  homeFatigueAvg Decimal @db.Decimal(8, 4)
  awayFatigueAvg Decimal @db.Decimal(8, 4)
  data           Json?

  simulation MatchSimulation @relation(fields: [simulationId], references: [id])

  @@index([simulationId])
}

model MatchTeamState {
  id                  String             @id @default(uuid(7)) @db.Uuid
  matchId             String             @db.Uuid
  clubId              String             @db.Uuid
  controlSource       MatchControlSource
  mentality           TacticalMentality  @default(BALANCED)
  pressing            PressingIntensity  @default(MEDIUM)
  marking             MarkingStyle       @default(ZONAL)
  tempo               TempoStyle         @default(NORMAL)
  formation           String
  lineHeight          Int                @default(50)
  defensiveWidth      Int                @default(50)
  attackingWidth      Int                @default(50)
  riskLevel           Int                @default(50)
  morale              Int                @default(50)
  fatigueAvg          Int                @default(0)
  tacticalCohesion    Int                @default(50)
  currentInstructions Json?
  version             Int                @default(1) // concorrência otimista (agregado C8 · runtime)

  match Match @relation(fields: [matchId], references: [id])

  @@unique([matchId, clubId])
}

/// Escalação da partida. Canônico (doc 15 §3.1, campo 8, PROPOSTO R-145):
/// a escalação usada pelo kernel é um SNAPSHOT CONGELADO E IMUTÁVEL no kickoff
/// (parte de `I`). Após `frozenAtTick`/PRE_MATCH ela NÃO pode mutar — corresponde
/// ao `lineupSnapshot` do manifesto; `lineupHash` prova a não-adulteração.
model MatchLineup {
  id                  String  @id @default(uuid(7)) @db.Uuid
  matchId             String  @db.Uuid
  clubId              String  @db.Uuid
  formation           String
  isInitial           Boolean @default(true)
  isImmutableSnapshot Boolean @default(true) // congelada no kickoff (não mutável)
  frozenAtTick        Int? // tick em que a escalação foi congelada (kickoff)
  snapshotJson        Json? // estado congelado (titulares/banco/funções) para o manifesto
  lineupHash          String? // hash do snapshot (integridade — doc 15 §3.3)

  match   Match               @relation(fields: [matchId], references: [id])
  players MatchLineupPlayer[]

  @@index([matchId])
}

model MatchLineupPlayer {
  id                        String         @id @default(uuid(7)) @db.Uuid
  lineupId                  String         @db.Uuid
  playerId                  String         @db.Uuid
  position                  PlayerPosition
  shirtNumber               Int?
  isStarter                 Boolean        @default(true)
  enteredMinute             Int?
  leftMinute                Int?
  tacticalRole              String?
  individualInstructionJson Json?

  lineup MatchLineup @relation(fields: [lineupId], references: [id])
  player Player      @relation(fields: [playerId], references: [id])

  @@index([lineupId])
  @@index([playerId])
}

model MatchEvent {
  id              String         @id @default(uuid(7)) @db.Uuid
  matchId         String         @db.Uuid
  clubId          String?        @db.Uuid
  playerId        String?        @db.Uuid
  relatedPlayerId String?        @db.Uuid
  type            MatchEventType
  minute          Int
  second          Int?
  eventSequence   Int // C-11: ordem TOTAL do feed por partida (desempata minute/second); a partida (matchId) é o escopo — MatchEvent não tem simulationId
  description     String
  importance      Int            @default(1)
  x               Decimal?       @db.Decimal(8, 4) // coordenada no campo
  y               Decimal?       @db.Decimal(8, 4)
  data            Json?

  match         Match   @relation(fields: [matchId], references: [id])
  player        Player? @relation("EventPlayer", fields: [playerId], references: [id])
  relatedPlayer Player? @relation("EventRelatedPlayer", fields: [relatedPlayerId], references: [id])

  @@unique([matchId, eventSequence]) // C-11: ordem total estável do feed
  @@index([matchId])
  @@index([playerId])
}

model PlayerMatchStats {
  id              String  @id @default(uuid(7)) @db.Uuid
  matchId         String  @db.Uuid
  playerId        String  @db.Uuid
  minutesPlayed   Int     @default(0)
  goals           Int
  assists         Int
  shots           Int
  shotsOnTarget   Int
  passesAttempted Int
  passesCompleted Int
  tackles         Int
  interceptions   Int
  foulsCommitted  Int
  yellowCards     Int
  redCards        Int
  saves           Int
  goalsConceded   Int
  rating          Decimal @default(6.00) @db.Decimal(4, 2)
  fatigueStart    Int
  fatigueEnd      Int
  moraleImpact    Int     @default(0)

  match  Match  @relation(fields: [matchId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
}

model MatchDecisionPoint {
  id                    String               @id @default(uuid(7)) @db.Uuid
  matchId               String               @db.Uuid
  clubId                String               @db.Uuid
  type                  DecisionPointType
  minute                Int
  title                 String
  description           String
  urgency               RecommendationImpact
  createdByStaffQuality Int?
  resolved              Boolean              @default(false)
  resolvedAt            DateTime?
  chosenActionId        String?              @db.Uuid
  data                  Json?
  version               Int                  @default(1) // concorrência otimista (agregado C8 · runtime)

  match           Match                       @relation(fields: [matchId], references: [id])
  recommendations MatchActionRecommendation[]

  @@index([matchId])
}

model MatchActionRecommendation {
  id                      String               @id @default(uuid(7)) @db.Uuid
  decisionPointId         String               @db.Uuid
  title                   String
  description             String
  impact                  RecommendationImpact
  confidence              Int
  tacticalChangeJson      Json?
  substitutionJson        Json?
  riskJson                Json?
  generatedByStaffRole    StaffRole?
  generatedByStaffQuality Int?

  decisionPoint MatchDecisionPoint @relation(fields: [decisionPointId], references: [id])

  @@index([decisionPointId])
}

// =============================================================================
// ESTATÍSTICAS, NARRATIVA, NOTIFICAÇÃO, AUTOMAÇÃO E AUDITORIA — §3.9–3.11
// =============================================================================

model ClubSeasonStats {
  id                  String    @id @default(uuid(7)) @db.Uuid
  clubId              String    @db.Uuid
  seasonId            String    @db.Uuid
  competitionSeasonId String?   @db.Uuid // M-04: dimensão por competição; NULL = agregado geral da temporada
  matchesPlayed       Int
  wins                Int
  draws               Int
  losses              Int
  goalsFor            Int
  goalsAgainst        Int
  points              Int
  finalPosition       Int?
  titlesWon           Int       @default(0)
  averageAttendance   Int       @default(0)
  fanMood             MoodLevel @default(NEUTRAL)

  club              Club               @relation(fields: [clubId], references: [id])
  competitionSeason CompetitionSeason? @relation(fields: [competitionSeasonId], references: [id])

  @@unique([clubId, seasonId, competitionSeasonId]) // M-04: agregado geral (NULL) coexiste com linhas por competição
}

model PlayerSeasonStats {
  id                  String  @id @default(uuid(7)) @db.Uuid
  playerId            String  @db.Uuid
  seasonId            String  @db.Uuid
  clubId              String? @db.Uuid
  competitionSeasonId String? @db.Uuid // M-04: dimensão por competição; NULL = agregado geral da temporada
  appearances         Int
  starts              Int
  minutesPlayed       Int
  goals               Int
  assists             Int
  yellowCards         Int
  redCards            Int
  averageRating       Decimal @default(0) @db.Decimal(4, 2)
  injuriesCount       Int     @default(0)

  player            Player             @relation(fields: [playerId], references: [id])
  competitionSeason CompetitionSeason? @relation(fields: [competitionSeasonId], references: [id])

  @@unique([playerId, seasonId, competitionSeasonId]) // M-04: agregado geral (NULL) coexiste com linhas por competição
}

model Narrative {
  id          String        @id @default(uuid(7)) @db.Uuid
  gameWorldId String        @db.Uuid
  clubId      String?       @db.Uuid
  playerId    String?       @db.Uuid
  type        NarrativeType
  title       String
  description String
  intensity   Int           @default(1)
  isActive    Boolean       @default(true)
  startsAt    DateTime      @default(now())
  endsAt      DateTime?
  effectsJson Json? // efeitos aplicados (moral, pressão, valor etc.)

  gameWorld GameWorld @relation(fields: [gameWorldId], references: [id])

  @@index([gameWorldId])
}

model Notification {
  id          String           @id @default(uuid(7)) @db.Uuid
  gameWorldId String?          @db.Uuid
  userId      String?          @db.Uuid
  clubId      String?          @db.Uuid
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false)
  priority    Int              @default(1)
  payload     Json?
  createdAt   DateTime         @default(now())
  readAt      DateTime?

  gameWorld GameWorld?   @relation(fields: [gameWorldId], references: [id])
  user      UserAccount? @relation(fields: [userId], references: [id])

  @@index([gameWorldId])
  @@index([userId])
}

/// Projeção transversal de auditoria — referência genérica (entity/entityId)
/// permitida. Forma canônica com cadeia de hash de integridade: AuditEvent (§6.3.11).
model GameAuditLog {
  id                    String   @id @default(uuid(7)) @db.Uuid
  gameWorldId           String?  @db.Uuid
  userId                String?  @db.Uuid
  clubId                String?  @db.Uuid
  action                String
  entity                String
  entityId              String?  @db.Uuid
  beforeJson            Json?
  afterJson             Json?
  metadata              Json?
  integrityHash         String? // C-12: hash deste registro (append-only, à prova de adulteração)
  previousIntegrityHash String? // C-12: encadeia ao registro anterior (hash-chain)
  createdAt             DateTime @default(now())

  gameWorld GameWorld? @relation(fields: [gameWorldId], references: [id])

  @@index([gameWorldId])
}

/// Atalho chave-valor para parâmetros simples de balanceamento por mundo.
/// Forma canônica de regras versionadas: RuleSet/RuleDefinition/RuleValue (§6.1).
model GameRuleConfig {
  id          String @id @default(uuid(7)) @db.Uuid
  gameWorldId String @db.Uuid
  key         String
  value       Json

  gameWorld GameWorld @relation(fields: [gameWorldId], references: [id])

  @@unique([gameWorldId, key])
}

/// Regra de automação por clube (§6.3.11). Execução referencia sempre a versão.
model AutomationRule {
  id            String               @id @default(uuid(7)) @db.Uuid
  gameWorldId   String               @db.Uuid
  clubId        String               @db.Uuid
  name          String
  level         AutomationLevel      @default(ASSISTED)
  status        AutomationRuleStatus @default(DRAFT)
  triggerJson   Json?
  conditionJson Json?
  actionJson    Json?
  version       Int                  @default(1)

  club Club @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id])

  @@index([gameWorldId, clubId])
}

// =============================================================================
// EVENTING / OUTBOX / EVENT SOURCING HÍBRIDO — §6.3.11 (concern Eventing/Projeção;
// context-map §5/§6). Publicação pós-commit AT_LEAST_ONCE + idempotência de consumo.
// Referência genérica (aggregateType/aggregateId) permitida por ser event log (§6.4).
// =============================================================================

/// Outbox transacional: evento gravado na MESMA tx do agregado e publicado
/// pós-commit. Ordenado por `sequence` (worldSequence). Forma granular §6.3.11: OutboxEvent.
model OutboxEvent {
  id               String       @id @default(uuid(7)) @db.Uuid // = eventId
  gameWorldId      String       @db.Uuid
  aggregateType    String
  aggregateId      String       @db.Uuid
  aggregateVersion BigInt?
  eventType        String
  eventVersion     Int          @default(1)
  payloadJson      Json
  status           OutboxStatus @default(PENDING)
  sequence         BigInt // worldSequence monotônico por mundo
  correlationId    String?      @db.Uuid
  causationId      String?      @db.Uuid
  contentHash      String? // integridade do payload
  attemptCount     Int          @default(0)
  occurredAt       DateTime     @default(now())
  publishedAt      DateTime?

  @@unique([gameWorldId, sequence])
  @@index([gameWorldId, status])
  @@index([aggregateType, aggregateId])
}

/// Idempotência de consumo (Inbox): 1 processamento por consumidor/evento.
/// Forma granular §6.3.11: InboxEvent. Constraint: unique(consumerName, eventId).
model InboxDedup {
  id           String   @id @default(uuid(7)) @db.Uuid
  consumerName String
  eventId      String   @db.Uuid
  gameWorldId  String?  @db.Uuid
  resultHash   String?
  processedAt  DateTime @default(now())

  @@unique([consumerName, eventId])
  @@index([gameWorldId])
}

/// Event sourcing híbrido: log append-only de eventos de domínio com cadeia de
/// hash de integridade (`prevEventHash`→`eventHash`). Forma granular §6.3.11:
/// DomainEvent. Ordem por agregado (aggregateVersion) e por mundo (sequence).
model DomainEventLog {
  id                  String   @id @default(uuid(7)) @db.Uuid // = eventId
  gameWorldId         String   @db.Uuid
  aggregateType       String
  aggregateId         String   @db.Uuid
  aggregateVersion    BigInt
  sequence            BigInt // worldSequence
  eventType           String
  eventVersion        Int      @default(1)
  payloadJson         Json
  actorType           String?
  actorId             String?  @db.Uuid
  correlationId       String?  @db.Uuid
  causationId         String?  @db.Uuid
  prevEventHash       String? // encadeamento de integridade
  eventHash           String?
  occurredAt          DateTime @default(now())
  occurredAtWorldTick BigInt?

  @@unique([gameWorldId, aggregateType, aggregateId, aggregateVersion])
  @@unique([gameWorldId, sequence])
  @@index([gameWorldId, eventType])
}

// =============================================================================
// CONCORRÊNCIA / RECUPERAÇÃO — idempotência de command e sagas (§6.3.11,
// context-map §6.3). Sem 2PC (Decisão 19.10); fencing por token monotônico.
// =============================================================================

/// Idempotência de command: 1 execução lógica por (actor, idempotencyKey) e 1 por
/// commandId. Forma granular §6.3.11: IdempotencyRecord/CommandExecution.
model IdempotencyKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  gameWorldId    String?   @db.Uuid
  actorId        String?   @db.Uuid
  idempotencyKey String
  commandId      String?   @db.Uuid
  commandType    String?
  status         String    @default("PENDING")
  resultHash     String?
  resultPayload  Json?
  errorCode      String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  expiresAt      DateTime?

  @@unique([actorId, idempotencyKey])
  @@unique([commandId])
  @@index([gameWorldId])
}

/// Saga / process manager (multiagregado, multicontexto). Cada passo é uma tx
/// local do contexto dono; falha posterior dispara compensação. Forma granular
/// §6.3.11: ProcessManager. Estados/timeouts finos: passo 10 da ordem de correção.
model SagaInstance {
  id            String     @id @default(uuid(7)) @db.Uuid
  gameWorldId   String     @db.Uuid
  sagaType      SagaType
  status        SagaStatus @default(CREATED)
  currentStep   Int        @default(0)
  correlationId String?    @db.Uuid
  contextJson   Json?
  fencingToken  BigInt     @default(0) // token monotônico (impede dois executores)
  lastError     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?
  version       Int        @default(1)

  steps SagaStep[]

  @@index([gameWorldId, status])
  @@index([sagaType, status])
}

/// Passo de uma saga (com estado de compensação). Forma granular §6.3.11: ProcessManagerStep.
model SagaStep {
  id                 String          @id @default(uuid(7)) @db.Uuid
  sagaInstanceId     String          @db.Uuid
  stepIndex          Int
  name               String
  status             SagaStepStatus  @default(PENDING)
  compensationStatus SagaStepStatus?
  attemptCount       Int             @default(0)
  payloadJson        Json?
  error              String?
  startedAt          DateTime?
  completedAt        DateTime?

  saga SagaInstance @relation(fields: [sagaInstanceId], references: [id])

  @@unique([sagaInstanceId, stepIndex])
  @@index([sagaInstanceId])
}

// =============================================================================
// LEDGER FINANCEIRO (partidas dobradas) — §6.3.9 + doc 13 (ledger e conservação).
// Saldo DERIVADO do razão (sem caixa editável isolado — fecha C-06). Conta pode
// ser de escopo CLUBE ou MUNDO (SYS_* de contraparte a faucet/sink — INV-3b).
// Forma granular §6.3.9: FinancialJournalEntry/FinancialJournalLine.
// =============================================================================

/// Conta do razão. `ownerScope=WORLD` + `systemAccount` para as SYS_* sistêmicas
/// (contraparte de faucet/sink; NÃO entram em `totalMoney`); `ownerScope=CLUB`
/// referencia um clube. Saldo deriva das linhas POSTED — não há coluna de saldo.
/// PROPOSTO (R-110) quanto ao `ownerScope=WORLD` das contas sistêmicas.
model FinancialAccount {
  id              String               @id @default(uuid(7)) @db.Uuid
  gameWorldId     String               @db.Uuid
  ownerScope      AccountOwnerScope    @default(CLUB)
  clubId          String?              @db.Uuid // nulo quando ownerScope=WORLD
  systemAccount   SystemAccount? // preenchido só para contas SYS_* (WORLD)
  accountCode     String
  accountType     FinancialAccountType
  normalSide      AccountNormalSide
  currencyId      String               @db.Uuid
  parentAccountId String?              @db.Uuid
  status          String               @default("ACTIVE")
  version         Int                  @default(1)

  club     Club?              @relation(fields: [gameWorldId, clubId], references: [gameWorldId, id]) // C-05: FK composta world-scoped
  parent   FinancialAccount?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children FinancialAccount[] @relation("AccountHierarchy")
  lines    JournalLine[]

  @@unique([gameWorldId, ownerScope, accountCode])
  @@unique([gameWorldId, systemAccount]) // 1 conta por SYS_* por mundo (nulos distintos)
  @@index([gameWorldId, clubId])
}

/// Lançamento (transação lógica) balanceado: Σ débitos = Σ créditos por moeda
/// (INV-3a). Ciclo DRAFT→POSTING→POSTED→REVERSED; só POSTED afeta saldo. Reversão
/// cria NOVO lançamento com `reversalOfJournalEntryId` (publicado nunca é editado).
/// `flowClass` (doc 13 §2.1): TRANSFER conserva; FAUCET cria; SINK destrói a oferta.
/// Forma granular §6.3.9: FinancialJournalEntry.
model JournalEntry {
  id                       String                  @id @default(uuid(7)) @db.Uuid
  gameWorldId              String                  @db.Uuid
  clubId                   String?                 @db.Uuid // clube "dono" (nulo p/ lançamento sistêmico puro)
  currencyId               String                  @db.Uuid
  flowClass                MoneyFlowClass
  financeType              FinanceTransactionType?
  status                   JournalEntryStatus      @default(DRAFT)
  description              String?
  reversalOfJournalEntryId String?                 @db.Uuid
  sourceEventId            String?                 @db.Uuid // idempotência da projeção (1 lançamento por evento)
  seasonNumber             Int?
  occurredAt               DateTime                @default(now())
  postedAt                 DateTime?
  version                  Int                     @default(1)

  lines JournalLine[]

  @@index([gameWorldId, clubId])
  @@index([gameWorldId, status])
}

/// Linha de débito/crédito. `amountMinor > 0` (CHECK em migration); o sinal vem
/// de `direction`. Constraint: soma dos débitos = soma dos créditos por lançamento
/// e moeda. Forma granular §6.3.9: FinancialJournalLine.
model JournalLine {
  id                 String               @id @default(uuid(7)) @db.Uuid
  gameWorldId        String               @db.Uuid
  journalEntryId     String               @db.Uuid
  lineNumber         Int
  financialAccountId String               @db.Uuid
  direction          JournalLineDirection
  amountMinor        BigInt // dinheiro em unidade mínima (> 0; sinal vem de `direction`)
  currencyId         String               @db.Uuid
  costCenterCode     String?
  referenceType      String?
  referenceId        String?              @db.Uuid

  entry   JournalEntry     @relation(fields: [journalEntryId], references: [id])
  account FinancialAccount @relation(fields: [financialAccountId], references: [id])

  @@unique([journalEntryId, lineNumber])
  @@index([financialAccountId])
  @@index([gameWorldId])
}

/// Buffer de accrual de desenvolvimento (doc 13 §5.2 — PROPOSTO R-113). Pós-partida
/// ACUMULA evidência por jogador/atributo/temporada; a mutação estrutural do
/// atributo ocorre 1× na virada (CMP-005). `pendingDeltaMinor` é delta ESCALADO
/// (base interna E8), NÃO dinheiro (o sufixo segue o nome do doc 13). Idempotência:
/// buffer consumido (zerado) na aplicação — reprocessar a virada não reaplica ganho.
model PlayerDevelopmentAccrual {
  id                String  @id @default(uuid(7)) @db.Uuid
  gameWorldId       String  @db.Uuid
  playerId          String  @db.Uuid
  seasonId          String  @db.Uuid
  attributeCode     String
  pendingDeltaMinor BigInt  @default(0) // delta escalado acumulado (±), NÃO-monetário
  evidenceCount     Int     @default(0)
  lastUpdatedTick   BigInt?
  version           Int     @default(1)

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, seasonId, attributeCode])
  @@index([gameWorldId, playerId])
}

// =============================================================================
// INSCRIÇÕES COMPETITIVAS (independentes do contrato) — §6.3.7 / context-map C7.
// Registro competitivo ≠ contrato (C6) ≠ elenco (C3). Cotas: estrangeiros,
// formados, limite de elenco. Relação inscrição↔competição é EXPLÍCITA (§6.4).
// =============================================================================

/// Inscrição de um clube numa edição (a "lista"/roster — SquadRegistration).
/// Guarda cotas e contadores. Invariante: 1 inscrição por clube/edição.
model CompetitionRegistration {
  id                  String             @id @default(uuid(7)) @db.Uuid
  gameWorldId         String             @db.Uuid
  competitionSeasonId String             @db.Uuid
  clubId              String             @db.Uuid
  status              RegistrationStatus @default(DRAFT)
  squadSizeLimit      Int? // limite de elenco inscrito
  foreignPlayerLimit  Int? // cota de estrangeiros
  homegrownMinimum    Int? // mínimo de formados (cota de formação)
  registeredCount     Int                @default(0)
  foreignCount        Int                @default(0)
  homegrownCount      Int                @default(0)
  submittedAt         DateTime?
  approvedAt          DateTime?
  version             Int                @default(1)

  competitionSeason CompetitionSeason    @relation(fields: [competitionSeasonId], references: [id])
  players           PlayerRegistration[]

  @@unique([competitionSeasonId, clubId]) // 1 inscrição por clube/edição
  @@index([gameWorldId, clubId])
}

/// Inscrição individual de jogador sob a lista do clube. `slotType` classifica o
/// jogador para as cotas. Invariantes: 1 inscrição por jogador/edição; nº de
/// camisa único por lista. Forma granular §6.3.5/§6.3.7: PlayerRegistration.
model PlayerRegistration {
  id             String               @id @default(uuid(7)) @db.Uuid
  gameWorldId    String               @db.Uuid
  registrationId String               @db.Uuid
  playerId       String               @db.Uuid
  clubId         String               @db.Uuid
  status         RegistrationStatus   @default(SUBMITTED)
  slotType       RegistrationSlotType @default(GENERAL)
  shirtNumber    Int?
  registeredAt   DateTime             @default(now())
  deregisteredAt DateTime?
  version        Int                  @default(1)

  registration CompetitionRegistration @relation(fields: [registrationId], references: [id])

  @@unique([registrationId, playerId]) // 1 inscrição por jogador/edição
  @@unique([registrationId, shirtNumber]) // nº de camisa único por lista (nulos distintos)
  @@index([gameWorldId, playerId])
}

// =============================================================================
// REPLAY — log imutável de commands da partida (`C` do kernel) — doc 15 §3.2.
// =============================================================================

/// Log imutável de commands da partida (`C`) para replay bit-a-bit (doc 15 §3.2 —
/// PROPOSTO R-145). Ordem-verdade por `matchSequence` (server-assigned);
/// `appliedAtTick` = tick determinístico de aplicação (§2.3). `payloadSnapshot` é
/// estado CONGELADO (não referência mutável). Reaplicar em ordem sobre (I,R,A,s) = replay.
model MatchCommandLog {
  id              String             @id @default(uuid(7)) @db.Uuid
  gameWorldId     String             @db.Uuid
  simulationId    String             @db.Uuid
  matchSequence   BigInt // ordem-verdade (server-assigned)
  appliedAtTick   Int // tick determinístico de aplicação
  commandType     String
  controlSource   MatchControlSource
  payloadSnapshot Json // estado congelado do command
  commandId       String             @db.Uuid // idempotência / desempate estável
  idempotencyKey  String?
  acceptedAt      DateTime           @default(now()) // auditoria (não entra no cálculo)

  simulation MatchSimulation @relation(fields: [simulationId], references: [id])

  @@unique([simulationId, matchSequence])
  @@index([gameWorldId])
}

// =============================================================================
// HISTÓRICO (append-only) — "a história nunca é apagada" (CMP-019, INV-6). §6.3.11.
// Projeções transversais: referência escalar/genérica controlada permitida (§6.4).
// =============================================================================

/// Livro da temporada (append-only): campeões, rebaixados, prêmios e recordes do
/// ano consolidados. Forma granular §6.3.11: SeasonHistoryBook.
model SeasonHistory {
  id           String   @id @default(uuid(7)) @db.Uuid
  gameWorldId  String   @db.Uuid
  seasonId     String   @db.Uuid
  seasonNumber Int
  summaryJson  Json? // campeões/rebaixados/prêmios/artilharia consolidados
  recordedAt   DateTime @default(now())

  @@unique([gameWorldId, seasonNumber])
  @@index([gameWorldId])
}

/// Livro de recordes (append-only): ocorrência + detentor de um recorde. Forma
/// granular §6.3.11: RecordDefinition/RecordOccurrence/RecordHolder (definição
/// separada da ocorrência). `holderType`/`holderId` = referência genérica controlada.
model RecordBook {
  id            String   @id @default(uuid(7)) @db.Uuid
  gameWorldId   String   @db.Uuid
  recordCode    String // ex.: MOST_GOALS_SEASON
  scope         String   @default("WORLD") // WORLD | CLUB | COMPETITION
  holderType    String? // PLAYER | CLUB | STAFF
  holderId      String?  @db.Uuid
  clubId        String?  @db.Uuid
  competitionId String?  @db.Uuid
  seasonNumber  Int?
  valueNumeric  Decimal? @db.Decimal(18, 4)
  valueText     String?
  achievedAt    DateTime @default(now())

  @@index([gameWorldId, recordCode])
}

/// Linha de história do clube (append-only): título, acesso, rebaixamento, troca
/// de identidade, marco. Forma granular §6.3.11: HistoricalEvent/ClubHistoricalIdentityPeriod.
model ClubHistoryEntry {
  id            String   @id @default(uuid(7)) @db.Uuid
  gameWorldId   String   @db.Uuid
  clubId        String   @db.Uuid
  entryType     String // TITLE | PROMOTION | RELEGATION | IDENTITY_CHANGE | MILESTONE
  seasonNumber  Int?
  competitionId String?  @db.Uuid
  title         String
  detailJson    Json?
  occurredAt    DateTime @default(now())

  @@index([gameWorldId, clubId])
}

/// Carreira do jogador (append-only): passagens por clube e marcos. Substitui a
/// visão introdutória `PlayerClubHistory` (§3.3). Forma granular §6.3.11:
/// PlayerCareerMilestone. Referência escalar (projeção histórica — §6.4).
model PlayerCareerHistory {
  id             String   @id @default(uuid(7)) @db.Uuid
  gameWorldId    String   @db.Uuid
  playerId       String   @db.Uuid
  clubId         String?  @db.Uuid
  entryType      String   @default("CLUB_SPELL") // CLUB_SPELL | MILESTONE | AWARD | RETIREMENT
  joinedAtSeason Int?
  leftAtSeason   Int?
  appearances    Int      @default(0)
  goals          Int      @default(0)
  assists        Int      @default(0)
  detailJson     Json?
  reason         String?
  recordedAt     DateTime @default(now())

  @@index([gameWorldId, playerId])
}

/// Histórico de transferências (append-only): toda transferência concluída fica
/// registrada para sempre (INV-6 — jogador não some sem evento). Forma granular §6.3.8.
model TransferHistory {
  id               String         @id @default(uuid(7)) @db.Uuid
  gameWorldId      String         @db.Uuid
  playerId         String         @db.Uuid
  fromClubId       String?        @db.Uuid
  toClubId         String?        @db.Uuid
  type             TransferType
  status           TransferStatus @default(COMPLETED)
  currencyId       String         @db.Uuid
  transferFeeMinor BigInt         @default(0) // dinheiro em unidade mínima
  seasonNumber     Int?
  sourceOfferId    String?        @db.Uuid
  completedAt      DateTime       @default(now())

  @@index([gameWorldId, playerId])
  @@index([gameWorldId, toClubId])
}
