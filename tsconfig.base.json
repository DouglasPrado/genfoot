{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@grinta/core": ["packages/core/src/index.ts"],
      "@grinta/persistence": ["packages/persistence/src/index.ts"],
      "@grinta/shared": ["packages/shared/src/index.ts"],
      "@grinta/design-system": ["packages/design-system/src/index.ts"],
      "@grinta/api-client": ["packages/api-client/src/index.ts"]
    }
  }
}
