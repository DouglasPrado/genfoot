# Postgres é o armazenamento oficial (R-173). Sobe com: docker compose up -d
DATABASE_URL=postgresql://grinta:grinta@localhost:5433/grinta?schema=public

# Verificação da identidade externa (R-171). Defina UM dos dois:
#
#  CLERK_JWT_KEY    Chave PÚBLICA (PEM) do Clerk — Dashboard → API Keys →
#                   "JWT public key". Preferido: verifica sem rede e sem dar à
#                   API poder para criar ou apagar usuário.
#  CLERK_SECRET_KEY Faz o SDK buscar o JWKS na API do Clerk. Funciona, mas é
#                   uma credencial mais poderosa do que verificar token exige.
#                   É o que `clerk env pull` escreve.
#
# Sem nenhum dos dois, /auth/session recusa sessão de usuário — falha fechado.
CLERK_JWT_KEY=
CLERK_SECRET_KEY=

# Porta de desenvolvimento: permite abrir sessão confiando no `subject` do
# corpo, sem prova. Existe para seed e testes. NUNCA ligue em produção — é
# exatamente a falha que a verificação de token consertou.
# GRINTA_API_ALLOW_DEV_SESSIONS=1

# Chave de bootstrap do admin.
# GRINTA_API_ADMIN_KEY=grinta-dev-admin

# Armazenamento de objetos — Cloudflare R2, S3-compatível.
# Nomes conforme `docs/02-tecnico/00-arquitetura-geral.md:283`.
#
# O R2 é dependência NÃO-crítica (`:277`): sem ele, upload e download param, e
# partidas, contratos e finanças seguem. Por isso a ausência destas variáveis
# não derruba o boot — ela desliga só o upload, e a API diz isso quando alguém
# pede uma intenção de upload.
#
# R2_ENDPOINT   https://<account-id>.r2.cloudflarestorage.com
# R2_CDN_URL    domínio público que serve o bucket. Sem ele não há como montar a
#               URL de leitura, e o objeto enviado seria inalcançável.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_CDN_URL=
